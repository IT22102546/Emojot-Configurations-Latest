  "assignment": {
    "triggers": [
      {
        "template": "complaintCreationAlert",
        "channel": "email",
        "target": "employee"
      }
    ],
    "automaticAssignment": {
      "isEnabled": true,
      "email": "abansauto@emojot.com",
      "resolvedStatus": [
        "Resolved"
      ],
      "maxLevel": 4,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 172800000
            },
            {
              "nextLevelTime": 172800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "1st Level"
                }
              ]
            },
            {
              "nextLevelTime": 172800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "nextLevelTime": 172800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        }
      ]
    }
