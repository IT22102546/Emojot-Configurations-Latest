  "status": {
    "name": "Status",
    "type": "enum",
    "transitions": [
      {
        "sourceState": "Open",
        "targetStates": [
          "Transferred",
          "In Progress"
        ]
      },
      {
        "sourceState": "Transferred",
        "targetStates": [
          "In Progress"
        ]
      },
      {
        "sourceState": "In Progress",
        "targetStates": [
          "Transferred",
          "Resolved"
        ]
      },
      {
        "sourceState": "Resolved",
        "targetStates": [
          "Open",
          "Transferred"
        ]
      }
    ],
    "values": [
      {
        "id": "Open",
        "name": "Open",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000",
        "statusBackgroundColor": "#fcf3cf",
        "statusTextColor": "#7d6608"
      },
      {
        "id": "Transferred",
        "name": "Transferred",
        "backgroundColor": "#f39c12",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#fdebd0",
        "statusTextColor": "#7e5109"
      },
      {
        "id": "In Progress",
        "name": "In Progress",
        "backgroundColor": "#3498db",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d6eaf8",
        "statusTextColor": "#154360",
        "triggers": [
          {
            "channel": "email",
            "template": "customerWIPalert",
            "target": "customer",
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Vehicle Purchase and Delivery",
                  "Vehicle Service",
                  "Spare Parts"
                ]
              ]
            }
          }
        ]
      },
      {
        "id": "Resolved",
        "name": "Resolved",
        "finalState": true,
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d5f5e3",
        "statusTextColor": "#145a32",
        "fieldsValidation": [
          {
            "fieldID": "inbuild_comment",
            "required": true,
            "name": "Please add a comment explaining how this complaint was resolved.",
            "message": "Please add a comment explaining how this complaint was resolved."
          }
        ],
        "triggers": [
          {
            "channel": "email",
            "template": "complaintResolutionAlertInternal",
            "target": "admin",
            "contacts": [
              "autocxmanagement@abansgroup.com",
              "automarketing@abansgroup.com"
            ],
            "appendEditUrl": true,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Vehicle Purchase and Delivery",
                  "Vehicle Service",
                  "Spare Parts"
                ]
              ]
            }
          },
          {
            "channel": "sms",
            "template": "complaintResolutionAlertInternal_sms",
            "target": "admin",
            "contacts": [
              "abansauto@emojot.com"
            ],
            "appendEditUrl": true,
            "condition": {
              "in": [
                {
                  "var": "type"
