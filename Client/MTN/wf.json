  "assignment": {
    "automaticAssignment": {
      "isEnabled": true,
      "email": "dheveshan.pillay@mtn.com",
      "resolvedStatus": [
        "Resolved"
      ],
      "maxLevel": 4,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 3600000
            },
            {
              "nextLevelTime": 172800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "1st Level"
                }
              ]
            },
            {
              "nextLevelTime": 172800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "nextLevelTime": 172800000,
              "fieldsChange": [
                {
                  "id": "overdue",
