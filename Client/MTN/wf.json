{
  "name": "WF",
  "reportNamePrefix": "MTN CelMate Concern",
  "reporterNamePrefix": "Customer",
  "nameTemplate": "MTN CelMate Concern: $type$ - $complaintType$",
  "descriptionFormat": "text",
  "timeZone": "+330",
  "type": {
    "name": "Concern Type",
    "type": "enum",
    "readOnly": true,
    "values": [
      {
        "id": "Customer Experience Survey",
        "name": "Customer Experience Survey",
        "highPriorityFields": [
          "complaintType",
          "FullName",
          "Email",
          "ContactNumber",
          "Store",
          "Satisfaction",
          "Main_reason",
          "Negative_Experience",
          "NPS",
          "Comment",
          "CelMate_Contact_Request",
          "overdue"
        ]
      },
      {
        "id": "Website Experience Survey",
        "name": "Website Experience Survey",
        "highPriorityFields": [
          "complaintType",
          "FullName",
          "Email",
          "ContactNumber",
          "Satisfaction",
          "Main_reason",
          "Information_Finding_Ease",
          "Task_Completion_Status",
          "Comment",
          "CelMate_Contact_Request",
          "overdue"
        ]
      },
      {
        "id": "googleMap",
        "name": "Google",
        "highPriorityFields": [
          "rating",
          "author",
          "reviewId",
          "location",
          "comments"
        ]
      },
      {
        "id": "facebook",
        "name": "Facebook",
        "highPriorityFields": [
          "rating",
          "author",
          "reviewId",
          "location",
          "comments"
        ]
      }
    ]
  },
  "priority": {
    "name": "Priority",
    "type": "enum",
    "values": [
      {
        "id": "Low",
        "name": "Low"
      },
      {
        "id": "Medium",
        "name": "Medium"
      },
      {
        "id": "High",
        "name": "High"
      }
    ]
  },
  "status": {
    "name": "Status",
    "type": "enum",
    "transitions": [
      {
        "sourceState": "Open",
        "targetStates": [
          "Transferred",
          "In Progress"
        ]
      },
      {
        "sourceState": "Transferred",
        "targetStates": [
          "In Progress"
        ]
      },
      {
        "sourceState": "In Progress",
        "targetStates": [
          "Transferred",
          "Resolved"
        ]
      },
      {
        "sourceState": "Resolved",
        "targetStates": [
          "Open",
          "Transferred"
        ]
      }
    ],
    "values": [
      {
        "id": "Open",
        "name": "Open",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000",
        "statusBackgroundColor": "#fcf3cf",
        "statusTextColor": "#7d6608"
      },
      {
        "id": "Transferred",
        "name": "Transferred",
        "backgroundColor": "#f39c12",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#fdebd0",
        "statusTextColor": "#7e5109"
      },
      {
        "id": "In Progress",
        "name": "In Progress",
        "backgroundColor": "#3498db",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d6eaf8",
        "statusTextColor": "#154360",
        "triggers": [
          {
            "channel": "email",
            "template": "MTN_customerWIPAlert",
            "target": "customer",
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Customer Experience Survey",
                  "Website Experience Survey"
                ]
              ]
            }
          }
        ]
      },
      {
        "id": "Resolved",
        "name": "Resolved",
        "finalState": true,
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d5f5e3",
        "statusTextColor": "#145a32",
        "fieldsValidation": [
          {
            "fieldID": "inbuild_comment",
            "required": true,
            "name": "Resolution Comment",
            "message": "Please add a comment explaining how this concern was resolved."
          }
        ],
        "triggers": [
          {
            "channel": "email",
            "template": "MTN_concernResolutionAlert",
            "target": "admin",
            "contacts": [
              "mtn@emojot.com"
            ],
            "appendEditUrl": true,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Customer Experience Survey",
                  "Website Experience Survey"
                ]
              ]
            }
          },
          {
            "channel": "email",
            "template": "MTN_ormConcernResolutionAlert",
            "target": "admin",
            "contacts": [
              "dheveshan.pillay@mtn.com",
              "info@mtncellmate.co.za",
              "larry@celmate.co.za",
              "sanjanan@emojot.com",
              "dewminil@emojot.com"
            ],
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "googleMap",
                  "facebook"
                ]
              ]
            }
          },
          {
            "channel": "email",
            "template": "MTN_customerResolutionAlert",
            "target": "customer",
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Customer Experience Survey",
                  "Website Experience Survey"
                ]
              ]
            }
          }
        ]
      }
    ]
  },
  "timeSpent": {
    "name": "Time spent",
    "type": "time_accumulation",
    "hidden": true
  },
