  "assignment": {
    "automaticAssignment": {
      "isEnabled": false,
      "email": "defaultassignee@emojot.com",
      "resolvedStatus": [
        "Resolved"
      ],
      "maxLevel": 3,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              },
              {
                "!=": [
                  {
                    "var": "overdue"
                  },
                  "3rd Level"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 86400000
            },
            {
              "nextLevelTime": 86400000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "nextLevelTime": 86400000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        }
      ]
    },
