  "status": {
    "name": "Status",
    "type": "enum",
    "values": [
      {
        "id": "Open",
        "name": "Open",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000",
        "statusBackgroundColor": "#fcf3cf",
        "statusTextColor": "#7d6608"
      },
      {
        "id": "In Progress",
        "name": "In Progress",
        "backgroundColor": "#3498db",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d6eaf8",
        "statusTextColor": "#154360",
        "triggers": [
          {
            "channel": "automaticEscalationReset"
          }
        ]
      },
      {
        "id": "Resolved",
        "name": "Resolved",
        "finalState": true,
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d5f5e3",
        "statusTextColor": "#145a32",
        "triggers": [
          {
            "channel": "email",
            "template": "complaintResolutionAlert",
            "target": "admin",
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Guest Experience Survey",
                  "Guest Request Form",
                  "Inquiry",
                  "Cancellation",
                  "Alteration",
                  "Complaint"
                ]
              ]
            },
            "contacts": [
              "shaveenf@emojot.com"
            ]
          },
          {
            "channel": "email",
            "template": "customerComplaintResolution",
            "target": "customer",
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "Guest Experience Survey",
                  "Guest Request Form",
                  "Inquiry",
                  "Cancellation",
                  "Alteration",
                  "Complaint"
                ]
              ]
            }
          },
          {
            "channel": "email",
            "template": "complaintResolutionAlert_orm",
            "target": "admin",
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "googleMap",
                  "booking",
                  "tripAdvisor"
                ]
              ]
            },
            "contacts": [
              "shaveenf@emojot.com"
            ]
          },
          {
            "channel": "email",
            "template": "complaintResolutionAlert_slt",
            "target": "admin",
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "facebook",
                  "instagram",
                  "twitter",
                  "youtube",
                  "web",
                  "reviews",
                  "other"
                ]
              ]
            },
            "contacts": [
              "shaveenf@emojot.com"
            ]
          }
        ]
      }
    ],
    "transitions": [
      {
        "sourceState": "Open",
        "targetStates": [
          "In Progress"
        ]
      },
      {
        "sourceState": "In Progress",
        "targetStates": [
          "Resolved"
        ]
      }
    ]
  },
