      "sections": [
        {
          "type": "header",
          "enabled": true,
          "height": 20,
          "backgroundColor": "{{colors.headerBg}}",
          "content": {
            "title": {
              "text": "PAN ASIA UNIFIED COMPLAINT REPORT",
              "fontSize": 14,
              "color": "{{colors.headerText}}"
            },
            "subtitle": {
              "template": "Complaint #{{incidentKey}} • Generated on {{generatedDate}} at {{generatedTime}}",
              "fontSize": 8,
              "color": "{{colors.headerSubtitle}}"
            }
          },
          "spacing": {
            "after": 5
          }
        },
        {
          "type": "statusCards",
          "spacing": {
            "after": 5
          },
          "cards": [
            {
              "label": "STATUS",
              "value": "{{status}}",
              "backgroundColor": "{{colors.cardBg}}",
              "border": {
                "color": "{{colors.border}}"
              }
            },
            {
              "label": "PRIORITY",
              "value": "{{priority}}",
              "backgroundColor": "{{colors.cardBg}}",
              "border": {
                "color": "{{colors.border}}"
              }
            },
            {
              "label": "CHANNEL",
              "value": "{{type}}",
              "backgroundColor": "{{colors.cardBg}}",
              "border": {
                "color": "{{colors.border}}"
              }
            },
            {
              "label": "ASSIGNED TO",
              "value": "{{assigneeUserName}}",
              "backgroundColor": "{{colors.cardBg}}",
              "border": {
                "color": "{{colors.border}}"
              }
            }
          ]
        },
        {
          "type": "contentSection",
          "layout": "twoColumn",
          "spacing": {
            "after": 5
          },
          "columns": [
            {
              "sections": [
                {
                  "type": "fieldSection",
                  "title": "Complaint Information",
                  "titleStyle": {
                    "fontSize": 10,
                    "color": "{{colors.titleText}}",
                    "backgroundColor": "{{colors.titleBg}}"
                  },
                  "fields": [
                    {
                      "label": "Complaint ID",
                      "value": "{{incidentKey}}"
                    },
                    {
                      "label": "Workflow",
                      "value": "{{name}}"
                    },
                    {
                      "label": "complaintDepartment",
                      "value": "{{type}}"
                    },
                    {
                      "label": "Department",
                      "value": "{{complaintDepartment}}"
                    },
                    {
                      "label": "Ticket Category",
                      "value": "{{ticketCategory}}"
                    },
                    {
                      "label": "Complaint Type",
                      "value": "{{complaintType}}"
                    }
                  ]
                }
              ]
            },
            {
              "sections": [
                {
                  "type": "fieldSection",
                  "title": "Customer Information",
                  "titleStyle": {
                    "fontSize": 10,
                    "color": "{{colors.titleText}}",
                    "backgroundColor": "{{colors.titleBg}}"
                  },
                  "fields": [
                    {
                      "label": "Customer Details",
                      "value": "{{customerDetailsLink}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "textSection",
          "title": "Issue Description",
          "field": {
            "value": "{{issueDescription}}",
            "backgroundColor": "{{colors.white}}",
            "border": {
              "color": "{{colors.border}}"
            },
            "style": {
              "fontSize": 8.5,
              "lineHeight": 4.5
            }
          }
        },
        {
          "type": "textSection",
          "title": "Customer Comment",
          "field": {
            "value": "{{comment}}",
            "backgroundColor": "{{colors.white}}",
            "border": {
              "color": "{{colors.border}}"
            },
            "style": {
              "fontSize": 8.5,
              "lineHeight": 4.5
            }
          }
        },
        {
          "type": "fieldSection",
          "title": "Attachments",
