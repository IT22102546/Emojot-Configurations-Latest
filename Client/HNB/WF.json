  "status": {
    "name": "Status",
    "type": "enum",
    "values": [
      {
        "id": "Open",
        "name": "Open",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000",
        "statusBackgroundColor": "#fcf3cf",
        "statusTextColor": "#7d6608"
      },
      {
        "id": "In Progress",
        "name": "In Progress",
        "backgroundColor": "#3498db",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d6eaf8",
        "statusTextColor": "#154360"
      },
      {
        "id": "Resolved",
        "name": "Resolved",
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d5f5e3",
        "statusTextColor": "#145a32",
        "triggers": [
          {
            "channel": "email",
            "template": "HNB_complaintResolutionAlert",
            "target": "admin",
            "contacts": [
              "anaza@emojot.com",
              "aqeelg@emojot.com",
              "csm@emojot.com",
              "gimhaniw@emojot.com",
              "sampath@emojot.com",
              "sanjanan@emojot.com",
              "shaveenf@emojot.com",
              "viraj@emojot.com",
              "zahrahr@emojot.com"
            ],
            "adminUserQuery": {
              "condition": "and",
              "rules": [
                {
                  "field": "complaintType",
                  "operator": "eq",
                  "value": "$complaintType$"
                }
              ]
            },
            "condition": {
              "and": [
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    "-"
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    null
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    ""
                  ]
                }
              ]
            }
          },
          {
            "channel": "email",
            "template": "HNB_complaintResolutionAlert",
            "target": "admin",
            "contacts": [
              "anaza@emojot.com",
              "aqeelg@emojot.com",
              "csm@emojot.com",
              "gimhaniw@emojot.com",
              "sampath@emojot.com",
              "sanjanan@emojot.com",
              "shaveenf@emojot.com",
              "viraj@emojot.com",
              "zahrahr@emojot.com"
            ],
            "condition": {
              "and": [
                {
                  "==": [
                    {
                      "var": "complaintType"
                    },
                    "Customer Complaint Survey"
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    "-"
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    null
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    ""
                  ]
                }
              ]
            },
            "adminUserQuery": {
              "condition": "and",
              "rules": [
                {
                  "field": "complaintType",
                  "operator": "eq",
                  "value": "$complaintType$"
                }
              ]
            }
          },
          {
            "channel": "email",
            "template": "HNB_complaintResolutionAlert_orm",
            "target": "admin",
            "contacts": [
              "anaza@emojot.com",
              "aqeelg@emojot.com",
              "csm@emojot.com",
              "gimhaniw@emojot.com",
              "sampath@emojot.com",
              "sanjanan@emojot.com",
              "viraj@emojot.com",
              "zahrahr@emojot.com"
            ],
            "condition": {
              "and": [
                {
                  "!=": [
                    {
                      "var": "type"
                    },
                    "Customer Satisfaction Survey"
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    "-"
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    null
                  ]
                },
                {
                  "!=": [
                    {
                      "var": "comment"
                    },
                    ""
                  ]
                }
              ]
            },
            "adminUserQuery": {
              "condition": "and",
              "rules": [
                {
                  "field": "complaintType",
                  "operator": "eq",
                  "value": "$complaintType$"
                }
              ]
            }
          },
          {
            "channel": "email",
            "template": "HNB_ResolutionAcknowledgement",
            "target": "customer"
          }
        ]
      }
    ]
  },
