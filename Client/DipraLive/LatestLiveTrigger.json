exports = async function (changeEvent) {

  console.log("============================================");
  console.log("DIPRA MASTER DATA SYNC START");
  console.log("============================================");


  /*
   * ============================================================
   * CONFIGURATION
   * ============================================================
   */

  const SERVICE_NAME =
    "Emojot-dev-New2";

  const COMPANY_ID =
    "61fa9273717213000f07db66";

  const INCIDENTS_DATABASE =
    "emojot_61fa9273717213000f07db66";

  const WORKFLOWS_DATABASE =
    "emojot";

  const INCIDENTS_COLLECTION =
    "Incidents";

  const WORKFLOWS_COLLECTION =
    "IncidentWorkflows";


  /*
   * ============================================================
   * WORKFLOW IDS
   * ============================================================
   */

   const WF = {

    CUSTOMERS:
      "6aacda282b21faf58cc28cf8",

    SUPPLIERS:
      "6aacda852cb42d36db52f3b3", 

    LOCATIONS:
      "6aacda5e2cb42d36db52f3b2",

    PRODUCT_CATALOG:
      "6aacda743e435a7d8c47e4f6",

    INSTALLED_MACHINES:
      "6aacda44616c549e7ffb5a17",

    AGREEMENT_WARRANTY:
      "6aacda1618672f7288975408"

  };


  /*
   * ============================================================
   * HELPERS
   * ============================================================
   */

  function oid(id) {

    return new BSON.ObjectId(id);

  }


  function workflowValues(id) {

    const values = [
      id
    ];


    try {

      values.push(
        oid(id)
      );

    } catch (e) {

      // ignore

    }


    return values;

  }


  function cleanObject(obj) {

    const result = {};


    Object.keys(obj).forEach(
      function (key) {

        if (
          obj[key] !== undefined &&
          obj[key] !== null
        ) {

          result[key] =
            obj[key];

        }

      }
    );


    return result;

  }


  /*
   * ============================================================
   * DATABASE
   * ============================================================
   */

  const mongo =
    context.services.get(
      SERVICE_NAME
    );


  if (
    !mongo ||
    typeof mongo.db !== "function"
  ) {

    throw new Error(
      "MongoDB service unavailable: " +
      SERVICE_NAME
    );

  }


  const incidents =
    mongo
      .db(INCIDENTS_DATABASE)
      .collection(INCIDENTS_COLLECTION);


  const workflows =
    mongo
      .db(WORKFLOWS_DATABASE)
      .collection(WORKFLOWS_COLLECTION);


  /*
   * ============================================================
   * SELECTOR BUILDER
   * ============================================================
   */

  function buildOption(
    id,
    name,
    changingFields
  ) {

    return {

      id:
        id,

      name:
        name,

      triggers: [
        {
          channel:
            "fieldChange",

          changingFields:
            changingFields
        }
      ]

    };

  }


  /*
   * ============================================================
   * MANUAL RUN
   *
   * AGREEMENT DROPDOWN REBUILD ONLY.
   *
   * This replaces only:
   *
   * customFields.customerName.values
   * customFields.supplierName.values
   * customFields.locationName.values
   * customFields.productName.values
   * customFields.serialNumber.values
   *
   * in Dipra_Agreement_Warranty_WF.
   * ============================================================
   */

  if (
    !changeEvent ||
    !changeEvent.operationType
  ) {

    console.log("============================================");
    console.log("AGREEMENT SELECTOR REBUILD START");
    console.log("============================================");


    /*
     * ==========================================================
     * CUSTOMERS
     * ==========================================================
     */

    const customers =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.CUSTOMERS
            )
        },

        customerCode: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        },

        customerName: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const customerOptions = [];

    const seenCustomers = {};


    customers.forEach(
      function (customer) {

        const code =
          String(
            customer.customerCode || ""
          ).trim();


        const name =
          String(
            customer.customerName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenCustomers[code]
        ) {

          return;

        }


        seenCustomers[code] =
          true;


        customerOptions.push(

          buildOption(

            code,

            name,

            [
              {
                id:
                  "customerCode",

                value:
                  code
              }
            ]

          )

        );

      }
    );


    customerOptions.sort(
      function (a, b) {

        return String(
          a.name
        ).localeCompare(
          String(
            b.name
          )
        );

      }
    );


    /*
     * ==========================================================
     * SUPPLIERS
     * ==========================================================
     */

    const suppliers =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.SUPPLIERS
            )
        },

        supplierCode: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        },

        supplierName: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const supplierOptions = [];

    const seenSuppliers = {};


    suppliers.forEach(
      function (supplier) {

        const code =
          String(
            supplier.supplierCode || ""
          ).trim();


        const name =
          String(
            supplier.supplierName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenSuppliers[code]
        ) {

          return;

        }


        seenSuppliers[code] =
          true;


        supplierOptions.push(

          buildOption(

            code,

            name,

            [
              {
                id:
                  "supplierCode",

                value:
                  code
              }
            ]

          )

        );

      }
    );


    supplierOptions.sort(
      function (a, b) {

        return String(
          a.name
        ).localeCompare(
          String(
            b.name
          )
        );

      }
    );


    /*
     * ==========================================================
     * PRODUCTS
     * ==========================================================
     */

    const products =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.PRODUCT_CATALOG
            )
        },

        productCode: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        },

        productName: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const productOptions = [];

    const seenProducts = {};


    products.forEach(
      function (product) {

        const code =
          String(
            product.productCode || ""
          ).trim();


        const name =
          String(
            product.productName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenProducts[code]
        ) {

          return;

        }


        seenProducts[code] =
          true;


        const changingFields = [

          {
            id:
              "productCode",

            value:
              code
          }

        ];


        if (
          product.supplierCode
        ) {

          changingFields.push({

            id:
              "supplierCode",

            value:
              product.supplierCode

          });

        }


        productOptions.push(

          buildOption(

            code,

            name,

            changingFields

          )

        );

      }
    );


    productOptions.sort(
      function (a, b) {

        return String(
          a.name
        ).localeCompare(
          String(
            b.name
          )
        );

      }
    );


    /*
     * ==========================================================
     * LOCATIONS
     * ==========================================================
     */

    const locations =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.LOCATIONS
            )
        },

        locationCode: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        },

        locationName: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const locationOptions = [];

    const seenLocations = {};


    locations.forEach(
      function (location) {

        const code =
          String(
            location.locationCode || ""
          ).trim();


        const name =
          String(
            location.locationName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenLocations[code]
        ) {

          return;

        }


        seenLocations[code] =
          true;


        const changingFields = [

          {
            id:
              "locationCode",

            value:
              code
          }

        ];


        if (
          location.customerCode
        ) {

          changingFields.push({

            id:
              "customerCode",

            value:
              location.customerCode

          });

        }


        locationOptions.push(

          buildOption(

            code,

            name,

            changingFields

          )

        );

      }
    );


    locationOptions.sort(
      function (a, b) {

        return String(
          a.name
        ).localeCompare(
          String(
            b.name
          )
        );

      }
    );


    /*
     * ==========================================================
     * INSTALLED MACHINES
     * ==========================================================
     */

    const machines =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.INSTALLED_MACHINES
            )
        },

        machineId: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        },

        serialNumber: {
          $exists:
            true,

          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const machineOptions = [];

    const seenMachines = {};


    machines.forEach(
      function (machine) {

        const machineId =
          String(
            machine.machineId || ""
          ).trim();


        const serialNumber =
          String(
            machine.serialNumber || ""
          ).trim();


        if (
          !machineId ||
          !serialNumber ||
          seenMachines[machineId]
        ) {

          return;

        }


        seenMachines[machineId] =
          true;


        const changingFields = [

          {
            id:
              "machineId",

            value:
              machineId
          }

        ];


        if (
          machine.productCode
        ) {

          changingFields.push({

            id:
              "productCode",

            value:
              machine.productCode

          });

        }


        if (
          machine.customerCode
        ) {

          changingFields.push({

            id:
              "customerCode",

            value:
              machine.customerCode

          });

        }


        if (
          machine.locationCode
        ) {

          changingFields.push({

            id:
              "locationCode",

            value:
              machine.locationCode

          });

        }


        if (
          machine.supplierCode
        ) {

          changingFields.push({

            id:
              "supplierCode",

            value:
              machine.supplierCode

          });

        }


        machineOptions.push(

          buildOption(

            machineId,

            serialNumber,

            changingFields

          )

        );

      }
    );


    machineOptions.sort(
      function (a, b) {

        return String(
          a.name
        ).localeCompare(
          String(
            b.name
          )
        );

      }
    );


    /*
     * ==========================================================
     * UPDATE AGREEMENT WORKFLOW ONLY
     * ==========================================================
     */

    const agreementFilter = {

      _id:
        oid(
          WF.AGREEMENT_WARRANTY
        ),

      companyID:
        COMPANY_ID

    };


    const result =
      await workflows.updateOne(

        agreementFilter,

        {

          $set: {

            "customFields.customerName.values":
              customerOptions,

            "customFields.supplierName.values":
              supplierOptions,

            "customFields.locationName.values":
              locationOptions,

            "customFields.productName.values":
              productOptions,

            "customFields.serialNumber.values":
              machineOptions

          }

        }

      );


    console.log(
      "Agreement matched:",
      result.matchedCount
    );


    console.log(
      "Agreement modified:",
      result.modifiedCount
    );


    console.log(
      "Customer options:",
      customerOptions.length
    );


    console.log(
      "Supplier options:",
      supplierOptions.length
    );


    console.log(
      "Product options:",
      productOptions.length
    );


    console.log(
      "Location options:",
      locationOptions.length
    );


    console.log(
      "Machine options:",
      machineOptions.length
    );


    console.log("============================================");
    console.log("AGREEMENT SELECTOR REBUILD COMPLETE");
    console.log("============================================");


    return {

      success:
        true,

      manualRun:
        true,

      agreementOnly:
        true,

      customerOptions:
        customerOptions.length,

      supplierOptions:
        supplierOptions.length,

      productOptions:
        productOptions.length,

      locationOptions:
        locationOptions.length,

      machineOptions:
        machineOptions.length

    };

  }


  /*
   * ============================================================
   * EVENT VALIDATION
   * ============================================================
   */

  const operation =
    changeEvent.operationType;


  if (
    operation !== "insert" &&
    operation !== "update" &&
    operation !== "replace"
  ) {

    return;

  }


  if (
    !changeEvent.ns ||
    changeEvent.ns.coll !==
      INCIDENTS_COLLECTION
  ) {

    return;

  }


  let doc =
    changeEvent.fullDocument;


  if (!doc) {

    console.log(
      "fullDocument missing."
    );


    return;

  }


  let workflowId =
    doc.workflow
      ? doc.workflow.toString()
      : "";


  if (!workflowId) {

    return;

  }


  console.log(
    "Operation:",
    operation
  );


  console.log(
    "Workflow:",
    workflowId
  );


  /*
   * ============================================================
   * DOCUMENT HELPERS
   * ============================================================
   */

  function get(field) {

    return doc[field];

  }


  async function refreshDoc() {

    const latest =
      await incidents.findOne({

        _id:
          doc._id

      });


    if (latest) {

      doc =
        latest;


      workflowId =
        doc.workflow
          ? doc.workflow.toString()
          : workflowId;

    }


    return doc;

  }


  async function updateCurrent(
    fields,
    label
  ) {

    const update =
      cleanObject(
        fields
      );


    if (
      Object.keys(
        update
      ).length === 0
    ) {

      return false;

    }


    const result =
      await incidents.updateOne(

        {
          _id:
            doc._id
        },

        {
          $set:
            update
        }

      );


    Object.keys(
      update
    ).forEach(
      function (field) {

        doc[field] =
          update[field];

      }
    );


    console.log(
      label || "CURRENT INCIDENT UPDATE",
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount
    );


    return (
      result.matchedCount === 1
    );

  }


  /*
   * ============================================================
   * TITLE FIX
   * ============================================================
   */

  async function refreshTitle(
    code
  ) {

    if (!code) {

      return;

    }


    const updates = {};


    [
      "name",
      "title",
      "incidentName"
    ].forEach(
      function (field) {

        const current =
          get(
            field
          );


        if (
          typeof current !== "string"
        ) {

          return;

        }


        const corrected =
          current.replace(

            /^(#\s*)?N\/A(?=\s*-)/i,

            function (
              match,
              prefix
            ) {

              return (
                prefix || ""
              ) +
              code;

            }

          );


        if (
          corrected !== current
        ) {

          updates[
            field
          ] =
            corrected;

        }

      }
    );


    await updateCurrent(
      updates,
      "TITLE UPDATE"
    );

  }


  /*
   * ============================================================
   * GENERATED CODE
   * ============================================================
   */

  async function assignGeneratedCode(
    field
  ) {

    await refreshDoc();


    const current =
      String(
        get(field) || ""
      ).trim();


    if (current) {

      return current;

    }


    const incidentKey =
      String(
        get(
          "incidentKey"
        ) || ""
      ).trim();


    if (!incidentKey) {

      return "";

    }


    await updateCurrent(

      {
        [field]:
          incidentKey
      },

      "ASSIGN " + field

    );


    await refreshDoc();


    const saved =
      String(
        get(field) || ""
      ).trim();


    await refreshTitle(
      saved
    );


    return saved;

  }


  /*
   * ============================================================
   * UPSERT SELECTOR
   * ============================================================
   */

  async function upsertSelector(
    targetWorkflowId,
    selectorField,
    option
  ) {

    if (
      !option ||
      !option.id
    ) {

      return;

    }


    const filter = {

      _id:
        oid(
          targetWorkflowId
        ),

      companyID:
        COMPANY_ID

    };


    const path =
      "customFields." +
      selectorField +
      ".values";


    const pull = {};


    pull[
      path
    ] = {

      id:
        option.id

    };


    await workflows.updateOne(

      filter,

      {
        $pull:
          pull
      }

    );


    const push = {};


    push[
      path
    ] =
      option;


    await workflows.updateOne(

      filter,

      {
        $push:
          push
      }

    );

  }


  /*
   * ============================================================
   * CUSTOMER SYNC
   * ============================================================
   */

  async function syncCustomer() {

    await refreshDoc();


    const customerCode =
      String(
        get(
          "customerCode"
        ) || ""
      ).trim();


    const customerName =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (
      !customerCode ||
      !customerName
    ) {

      return;

    }


    const option =
      buildOption(

        customerCode,

        customerName,

        [
          {
            id:
              "customerCode",

            value:
              customerCode
          }
        ]

      );


    await upsertSelector(
      WF.LOCATIONS,
      "customerName",
      option
    );


    await upsertSelector(
      WF.INSTALLED_MACHINES,
      "customerName",
      option
    );


    await upsertSelector(
      WF.AGREEMENT_WARRANTY,
      "customerName",
      option
    );

  }


  /*
   * ============================================================
   * SUPPLIER SYNC
   * ============================================================
   */

  async function syncSupplier() {

    await refreshDoc();


    const supplierCode =
      String(
        get(
          "supplierCode"
        ) || ""
      ).trim();


    const supplierName =
      String(
        get(
          "supplierName"
        ) || ""
      ).trim();


    if (
      !supplierCode ||
      !supplierName
    ) {

      return;

    }


    const option =
      buildOption(

        supplierCode,

        supplierName,

        [
          {
            id:
              "supplierCode",

            value:
              supplierCode
          }
        ]

      );


    await upsertSelector(
      WF.PRODUCT_CATALOG,
      "supplierName",
      option
    );


    await upsertSelector(
      WF.INSTALLED_MACHINES,
      "supplierName",
      option
    );


    await upsertSelector(
      WF.AGREEMENT_WARRANTY,
      "supplierName",
      option
    );

  }


  /*
   * ============================================================
   * LOCATION CUSTOMER
   * ============================================================
   */

  async function resolveLocationCustomer() {

    await refreshDoc();


    const selected =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (!selected) {

      return;

    }


    const customer =
      await incidents.findOne({

        workflow: {
          $in:
            workflowValues(
              WF.CUSTOMERS
            )
        },

        $or: [
          {
            customerCode:
              selected
          },
          {
            customerName:
              selected
          }
        ]

      });


    if (!customer) {

      return;

    }


    await updateCurrent(

      {
        customerCode:
          customer.customerCode
      },

      "LOCATION CUSTOMER CODE"

    );

  }


  /*
   * ============================================================
   * LOCATION CODE
   * ============================================================
   */

  async function assignLocationCode() {

    await refreshDoc();


    const customerCode =
      String(
        get(
          "customerCode"
        ) || ""
      ).trim();


    const incidentKey =
      String(
        get(
          "incidentKey"
        ) || ""
      ).trim();


    if (!incidentKey) {

      return;

    }


    let locationCode =
      incidentKey;


    if (
      customerCode &&
      incidentKey.indexOf(
        "_L"
      ) === 0
    ) {

      locationCode =
        customerCode +
        incidentKey;

    }


    await updateCurrent(

      {
        locationCode:
          locationCode,

        incidentKey:
          locationCode
      },

      "LOCATION CODE"

    );


    await refreshTitle(
      locationCode
    );


    return locationCode;

  }


  /*
   * ============================================================
   * LOCATION SYNC
   * ============================================================
   */

  async function syncLocation() {

    await refreshDoc();


    const locationCode =
      String(
        get(
          "locationCode"
        ) || ""
      ).trim();


    const locationName =
      String(
        get(
          "locationName"
        ) || ""
      ).trim();


    if (
      !locationCode ||
      !locationName
    ) {

      return;

    }


    const fields = [

      {
        id:
          "locationCode",

        value:
          locationCode
      }

    ];


    if (
      get(
        "route"
      )
    ) {

      fields.push({

        id:
          "route",

        value:
          get(
            "route"
          )

      });

    }


    if (
      get(
        "customerCode"
      )
    ) {

      fields.push({

        id:
          "customerCode",

        value:
          get(
            "customerCode"
          )

      });

    }


    const option =
      buildOption(

        locationCode,

        locationName,

        fields

      );


    await upsertSelector(
      WF.INSTALLED_MACHINES,
      "locationName",
      option
    );


    await upsertSelector(
      WF.AGREEMENT_WARRANTY,
      "locationName",
      option
    );

  }


  /*
   * ============================================================
   * PRODUCT SUPPLIER
   * ============================================================
   */

  async function resolveProductSupplier() {

    await refreshDoc();


    const selected =
      String(
        get(
          "supplierName"
        ) || ""
      ).trim();


    if (!selected) {

      return;

    }


    const supplier =
      await incidents.findOne({

        workflow: {
          $in:
            workflowValues(
              WF.SUPPLIERS
            )
        },

        $or: [
          {
            supplierCode:
              selected
          },
          {
            supplierName:
              selected
          }
        ]

      });


    if (!supplier) {

      return;

    }


    await updateCurrent(

      {
        supplierCode:
          supplier.supplierCode
      },

      "PRODUCT SUPPLIER CODE"

    );

  }


  /*
   * ============================================================
   * PRODUCT SYNC
   * ============================================================
   */

  async function syncProduct() {

    await refreshDoc();


    const productCode =
      String(
        get(
          "productCode"
        ) || ""
      ).trim();


    const productName =
      String(
        get(
          "productName"
        ) || ""
      ).trim();


    if (
      !productCode ||
      !productName
    ) {

      return;

    }


    const fields = [

      {
        id:
          "productCode",

        value:
          productCode
      }

    ];


    if (
      get(
        "brandName"
      )
