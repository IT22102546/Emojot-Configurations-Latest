  /*
   * ============================================================
   * MACHINE SYNC
   * ============================================================
   */

  async function syncMachine() {

    await refreshDoc();


    const machineId =
      String(
        get(
          "machineId"
        ) || ""
      ).trim();


    const serialNumber =
      String(
        get(
          "serialNumber"
        ) || ""
      ).trim();


    if (
      !machineId ||
      !serialNumber
    ) {

      return;

    }


    const changingFields = [

      {
        id:
          "machineId",

        value:
          machineId
      }

    ];


    [
      "productCode",
      "customerCode",
      "locationCode",
      "supplierCode"
    ].forEach(
      function (field) {

        const value =
          get(
            field
          );


        if (
          value !== undefined &&
          value !== null &&
          value !== ""
        ) {

          changingFields.push({

            id:
              field,

            value:
              value

          });

        }

      }
    );


    const option =
      buildOption(

        machineId,

        serialNumber,

        changingFields

      );


    await upsertSelector(
      WF.AGREEMENT_WARRANTY,
      "serialNumber",
      option
    );

  }


