  "assignment": {
    "triggers": [
      {
        "channel": "email",
        "template": "eventSupportAssignmentAlert",
        "target": "admin"
      }
    ],
    "automaticAssignment": {
      "isEnabled": false,
      "email": "bot@emojot.com",
      "resolvedStatus": [
        "Resolved",
        "Closed"
      ],
      "maxLevel": 3,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              },
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Closed"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 1800000
            },
            {
              "nextLevelTime": 1800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "1st Level"
                }
              ]
            },
            {
              "nextLevelTime": 3600000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            }
          ]
        }
      ]
    }
  },
