  "workflowCreation": {
    "email": "bot@emojot.com",
    "triggers": [
      {
        "channel": "email",
        "template": "piiRequestCreationAlert",
        "target": "admin",
        "contacts": [
          "shaveenf@emojot.com",
          "sanjanan@emojot.com"
        ],
        "condition": {
          "in": [
            {
              "var": "type"
            },
            [
              "For self",
              "On behalf",
              "For client representative"
            ]
          ]
        }
      },
      {
        "template": "piiRequestCreationAlertCustomer",
        "channel": "email",
        "target": "customer",
        "appendEditUrl": false,
        "condition": {
          "in": [
            {
              "var": "type"
            },
            [
              "For self",
              "On behalf",
              "For client representative"
            ]
          ]
        }
      },
      {
        "channel": "fieldChange",
        "changingFields": [
          {
            "id": "assignee",
            "value": "privacy@emojot.com"
          }
        ]
      }
    ]
  },
  "assignment": {
    "triggers": [
            {
                "template": "piiReqAssignment",
                "channel": "email",
                "target": "employee",
                "appendEditUrl": false
            }
        ],
    "automaticAssignment": {
      "isEnabled": true,
      "email": "privacy@emojot.com",
      "resolvedStatus": [
        "Completed",
        "Rejected"
      ],
      "maxLevel": 0,
      "triggerFlows": []
    }
  },
  "adminHierarchy": {
    "id": "REPLACE_PLATFORMSEC_ADMIN_HIERARCHY_ID",
    "list": "admin",
    "headers": [
      {
        "id": "requesterType",
        "name": "Requester Type",
        "type": "customField"
      },
      {
        "id": "requestType",
        "name": "Request Type",
        "type": "customField"
      },
      {
        "id": "ticketAssignee",
        "name": "Ticket Assignee",
        "type": "contact"
      }
    ]
  },
  "finalState": true,
  "incidentKeyFormat": {
    "enabled": false,
    "countDependentFields": {
      "enabled": true,
      "fields": [
        "date",
        "ticketCategory"
      ]
    },
    "pattern": [
      {
        "key": "ticketCategory",
        "format": "mapping"
      },
      {
        "key": "date",
        "format": "YYYYMMDD"
      },
      {
        "key": "counter",
        "format": 3
      }
    ],
    "counterReset": "daily",
    "fieldMappings": {
      "ticketCategory": {
        "mappings": {
          "customerFeedbackSurvey": "CFS",
          "WebsiteSurvey": "WBS",
          "CallcenterSurvey": "CCS"
        },
        "default": "UCM"
      }
    }
  },
  "predefinedComments": [
    "Case acknowledged and assigned.",
    "Customer contacted; details requested.",
    "Initial verification completed.",
    "Escalated to relevant team.",
    "Resolution confirmed; case closed."
  ],
  "tableEdit": "false"
}