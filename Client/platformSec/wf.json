{
  "name": "dataRightsWF",
  "reportNamePrefix": "PII Data Rights Request",
  "nameTemplate": "PII Data Rights Request: $type$ - $requestType$",
  "reporterNamePrefix": "Requester",
  "descriptionFormat": "text",
  "timeZone": "+330",
  "type": {
    "name": "Requester Type",
    "type": "enum",
    "readOnly": true,
    "values": [
      {
        "id": "For self",
        "name": "For self",
        "highPriorityFields": [
          "requestType",
          "selfFullName",
          "selfEmail",
          "selfContactNumber",
          "interactedOrganization",
          "additionalInformation",
          "attachment"
        ]
      },
      {
        "id": "On behalf",
        "name": "On behalf",
        "highPriorityFields": [
          "requestType",
          "requestorFullName",
          "requestorEmail",
          "requestorContactNumber",
          "dataSubjectFullName",
          "dataSubjectEmail",
          "relationshipToDataSubject",
          "interactedOrganization",
          "additionalInformation",
          "attachment"
        ]
      },
      {
        "id": "For client representative",
        "name": "For client representative",
        "highPriorityFields": [
          "requestType",
          "representativeFullName",
          "representativeEmail",
          "clientCompanyName",
          "dataSubjectFullName",
          "dataSubjectEmail",
          "clientReferenceTicketId",
          "clientOrganizationName",
          "clientAdditionalInformation",
          "interactedOrganization",
          "additionalInformation",
          "attachment"
        ]
      }
    ]
  },
  "priority": {
    "name": "Priority",
    "type": "enum",
    "values": [
      {
        "id": "Low",
        "name": "Low"
      },
      {
        "id": "Medium",
        "name": "Medium"
      },
      {
        "id": "High",
        "name": "High"
      }
    ]
  },
  "status": {
    "name": "Status",
    "type": "enum",
    "transitions": [
      {
        "sourceState": "Triage",
        "targetStates": [
          "Request Acknowledged"
        ]
      },
      {
        "sourceState": "Request Acknowledged",
        "targetStates": [
          "Transferred to CSM",
          "Transferred to Client"
        ]
      },
      {
        "sourceState": "Transferred to CSM",
        "targetStates": [
          "Transferred to Privacy"
        ]
      },
      {
        "sourceState": "Transferred to Client",
        "targetStates": [
          "Transferred to Emojot"
        ]
      },
      {
        "sourceState": "Transferred to Privacy",
        "targetStates": [
          "Completed",
          "Rejected"
        ]
      },
      {
        "sourceState": "Transferred to Emojot",
        "targetStates": [
          "Completed",
          "Rejected"
        ]
      },
      {
        "sourceState": "Rejected",
        "targetStates": [
          "Triage"
        ]
      }
    ],
    "values": [
      {
        "id": "Triage",
        "name": "Triage",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000",
        "statusBackgroundColor": "#fcf3cf",
        "statusTextColor": "#7d6608"
      },
      {
        "id": "Request Acknowledged",
        "name": "Request Acknowledged",
        "backgroundColor": "#3498db",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d6eaf8",
        "statusTextColor": "#154360",
        "triggers": [
          {
            "channel": "email",
            "template": "piiRequestAcknowledgmentAlert",
            "target": "customer",
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "For self",
                  "On behalf",
                  "For client representative"
                ]
              ]
            }
          }
        ]
      },
      {
        "id": "Transferred to CSM",
        "name": "Transferred to CSM",
        "backgroundColor": "#9b59b6",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#eadcf8",
        "statusTextColor": "#4a235a"
      },
      {
        "id": "Transferred to Privacy",
        "name": "Transferred to Privacy",
        "backgroundColor": "#9b59b6",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#eadcf8",
        "statusTextColor": "#4a235a"
      },
      {
        "id": "Transferred to Emojot",
        "name": "Transferred to Emojot",
        "backgroundColor": "#9b59b6",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#eadcf8",
        "statusTextColor": "#4a235a"
      },
      {
        "id": "Transferred to Client",
        "name": "Transferred to Client",
        "backgroundColor": "#e67e22",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#fae5d3",
        "statusTextColor": "#6e2c00"
      },
      {
        "id": "Completed",
        "name": "Completed",
        "finalState": true,
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#d5f5e3",
        "statusTextColor": "#145a32",
        "fieldsValidation": [
          {
            "fieldID": "inbuild_comment",
            "required": true,
            "message": "Please add a comment explaining how this request was resolved."
          }
        ],
        "triggers": [
          {
            "channel": "email",
            "template": "piiRequestCompletedAlert",
            "target": "customer",
            "appendEditUrl": false,
            "condition": {
              "in": [
                {
                  "var": "type"
                },
                [
                  "For self",
                  "On behalf",
                  "For client representative"
                ]
              ]
            }
          }
        ]
      },
      {
        "id": "Rejected",
        "name": "Rejected",
        "finalState": true,
        "backgroundColor": "#c0392b",
        "textColor": "#ffffff",
        "statusBackgroundColor": "#f5b7b1",
        "statusTextColor": "#641e16",
        "fieldsValidation": [
          {
            "fieldID": "inbuild_comment",
            "required": true,
            "message": "Please add a comment explaining why this request was rejected."
          }
        ]
      }
    ]
  },
  "timeSpent": {
    "name": "Time spent",
    "type": "time_accumulation",
    "hidden": true
  },
