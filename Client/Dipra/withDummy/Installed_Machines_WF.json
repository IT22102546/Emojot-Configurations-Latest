{
  "name": "Dipra Installed Machines",
  "reportNamePrefix": "Machine",
  "reporterNamePrefix": "Submitted By",
  "nameTemplate": "$machineId$ - $serialNumber$",
  "descriptionTemplate": "$productName$ at $locationName$",
  "descriptionFormat": "text",
  "timeZone": -330,
  "type": {
    "name": "Record Type",
    "type": "enum",
    "readOnly": true,
    "values": [
      {
        "id": "Installed Machine",
        "name": "Installed Machine",
        "highPriorityFields": [
          "machineId",
          "serialNumber",
          "productName",
          "productCode",
          "brand",
          "model",
          "capacity",
          "unit",
          "customerName",
          "customerCode",
          "locationName",
          "locationCode",
          "supplierName",
          "supplierCode",
          "installedLocatedDate",
          "route",
          "machineAttributes",
          "warrantyStartDate",
          "warrantyExpiryDate",
          "warrantyReminderDate",
          "currentAgreementNumber",
          "previousSerialNumber",
          "serialChangeReason",
          "remarks"
        ]
      }
    ]
  },
  "priority": {
    "name": "Priority",
    "type": "enum",
    "readOnly": true,
    "values": [
      {
        "id": "Medium",
        "name": "Medium"
      }
    ]
  },
  "status": {
    "name": "Machine Status",
    "type": "enum",
    "transitions": [
      {
        "sourceState": "Pending Installation",
        "targetStates": [
          "Active"
        ]
      },
      {
        "sourceState": "Active",
        "targetStates": [
          "Under Service",
          "Replaced",
          "Decommissioned"
        ]
      },
      {
        "sourceState": "Under Service",
        "targetStates": [
          "Active",
          "Replaced",
          "Decommissioned"
        ]
      }
    ],
    "values": [
      {
        "id": "Pending Installation",
        "name": "Pending Installation",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000"
      },
      {
        "id": "Active",
        "name": "Active",
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff"
      },
      {
        "id": "Under Service",
        "name": "Under Service",
        "backgroundColor": "#3498db",
        "textColor": "#ffffff"
      },
      {
        "id": "Replaced",
        "name": "Replaced",
        "finalState": true,
        "backgroundColor": "#8e44ad",
        "textColor": "#ffffff"
      },
      {
        "id": "Decommissioned",
        "name": "Decommissioned",
        "finalState": true,
        "backgroundColor": "#7f8c8d",
        "textColor": "#ffffff"
      }
    ]
  },
