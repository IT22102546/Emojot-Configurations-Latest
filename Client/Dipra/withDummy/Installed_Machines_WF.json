      { "key": "productCode", "label": "Product Code", "target": "productCode", "fieldType": "string", "required": true },
      { "key": "productName", "label": "Select Product Name", "target": "productName", "fieldType": "enum", "required": true },
      { "key": "brand", "label": "Brand", "target": "brand", "fieldType": "string", "required": true },
      { "key": "model", "label": "Model", "target": "model", "fieldType": "string", "required": true },
