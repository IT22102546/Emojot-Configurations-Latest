      {
        "sourceState": "Draft",
        "targetStates": [
          "Active"
        ]
      },
      {
        "sourceState": "Active",
        "targetStates": [
          "Discontinued"
        ]
      },
      {
        "sourceState": "Discontinued",
        "targetStates": [
          "Active"
        ]
      }
    ],
    "values": [
      {
        "id": "Draft",
        "name": "Draft",
        "backgroundColor": "#f1c40f",
        "textColor": "#000000"
      },
      {
        "id": "Active",
        "name": "Active",
        "backgroundColor": "#27ae60",
        "textColor": "#ffffff"
      },
      {
        "id": "Discontinued",
        "name": "Discontinued",
        "backgroundColor": "#7f8c8d",
        "textColor": "#ffffff"
      }
    ]
  },
  "customFields": {
