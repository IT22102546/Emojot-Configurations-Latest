      { "key": "productCode", "label": "Product Code", "target": "productCode", "fieldType": "string", "required": true },
      { "key": "productName", "label": "Product Name", "target": "productName", "fieldType": "string", "required": true },
      { "key": "supplierCode", "label": "Supplier Code", "target": "supplierCode", "fieldType": "string", "required": true },
      { "key": "supplierName", "label": "Select Supplier Name", "target": "supplierName", "fieldType": "enum", "required": true },
