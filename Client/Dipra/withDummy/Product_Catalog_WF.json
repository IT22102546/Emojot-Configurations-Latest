                  "value": "SUP-002"
                }
              ]
            }
          ]
        }
      ]
    },
    "brandCode": {
      "name": "Brand Code",
      "type": "string"
    },
    "brandName": {
      "name": "Brand Name",
      "type": "string"
    },
    "modelCode": {
      "name": "Model Code",
      "type": "string"
    },
    "modelName": {
      "name": "Model Name",
      "type": "string"
    },
    "capacity": {
      "name": "Capacity",
      "type": "number"
    },
    "capacityUnit": {
      "name": "Capacity Unit",
