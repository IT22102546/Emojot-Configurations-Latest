{
  "name": "Dipra Product Catalog",
  "reportNamePrefix": "Product",
  "reporterNamePrefix": "Submitted By",
  "nameTemplate": "$productCode$ - $productName$",
  "descriptionTemplate": "$description$",
  "descriptionFormat": "text",
  "timeZone": -330,
  "type": {
    "name": "Record Type",
    "type": "enum",
    "readOnly": true,
    "values": [
      {
        "id": "Product",
        "name": "Product",
        "highPriorityFields": [
          "productCode",
          "productName",
          "supplierName",
          "supplierCode",
          "brandCode",
          "brandName",
          "modelCode",
          "modelName",
          "capacity",
          "capacityUnit",
          "productType",
          "machineAttributes",
          "description"
        ]
      }
    ]
  },
  "priority": {
    "name": "Priority",
    "type": "enum",
    "readOnly": true,
    "values": [
      {
        "id": "Medium",
        "name": "Medium"
      }
    ]
  },
  "status": {
    "name": "Status",
    "type": "enum",
