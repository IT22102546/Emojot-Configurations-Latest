      "name": "Product Code",
      "type": "string"
    },
    "productName": {
      "name": "Product Name",
      "type": "string"
    },
    "supplierCode": {
      "name": "Supplier Code",
      "type": "string",
      "readOnly": true
    },
    "supplierName": {
