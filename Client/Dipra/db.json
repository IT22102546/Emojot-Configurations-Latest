      }

    }


    /*
     * LOCATION
     */

    const selectedLocation =
      String(
        get(
          "locationName"
        ) || ""
      ).trim();


    if (selectedLocation) {

      const location =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.LOCATIONS
              )
          },

          $or: [
            {
              locationCode:
                selectedLocation
            },
            {
              locationName:
                selectedLocation
            }
          ]

        });


      if (
        location &&
        location.locationCode
      ) {

        updates.locationCode =
          location.locationCode;

      }

    }


    /*
     * PRODUCT
     */

    const selectedProduct =
      String(
        get(
          "productName"
        ) || ""
      ).trim();


    if (selectedProduct) {

      const product =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.PRODUCT_CATALOG
              )
          },

          $or: [
            {
              productCode:
                selectedProduct
            },
            {
              productName:
                selectedProduct
            }
          ]

        });


      if (
        product &&
        product.productCode
      ) {

        updates.productCode =
          product.productCode;

      }


      if (
        product &&
        product.supplierCode &&
        !updates.supplierCode
      ) {

        updates.supplierCode =
          product.supplierCode;

      }

    }


    /*
     * INSTALLED MACHINE
     */

    const selectedMachine =
      String(
        get(
          "serialNumber"
        ) || ""
      ).trim();


    if (selectedMachine) {

      const machine =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.INSTALLED_MACHINES
              )
          },

          $or: [
            {
              machineId:
                selectedMachine
            },
            {
              serialNumber:
                selectedMachine
            }
          ]

        });


      if (machine) {

        if (
          machine.machineId
        ) {

          updates.machineId =
            machine.machineId;

        }


        if (
          machine.productCode
        ) {

          updates.productCode =
            machine.productCode;

        }


        if (
          machine.customerCode
        ) {

          updates.customerCode =
            machine.customerCode;

        }


        if (
          machine.locationCode
        ) {

          updates.locationCode =
            machine.locationCode;

        }


        if (
          machine.supplierCode
        ) {

          updates.supplierCode =
            machine.supplierCode;

        }

      }

    }


    if (
      Object.keys(
        updates
      ).length > 0
    ) {

      await updateCurrent(
        updates,
        "AGREEMENT DERIVED FIELDS"
      );

    }


    await refreshDoc();


    console.log(
      "AGREEMENT FINAL:",
      "| customerCode:",
      get("customerCode"),
      "| supplierCode:",
      get("supplierCode"),
      "| locationCode:",
      get("locationCode"),
      "| productCode:",
      get("productCode"),
      "| machineId:",
      get("machineId")
    );

  }


  /*
   * ============================================================
   * ROUTING
   * ============================================================
   */

  try {

    switch (
      workflowId
    ) {


      /*
       * CUSTOMER
       */

      case WF.CUSTOMERS: {

        await assignGeneratedCode(
          "customerCode"
        );


        await refreshDoc();


        await syncCustomer();


        break;

      }


      /*
       * SUPPLIER
       */

      case WF.SUPPLIERS: {

        await assignGeneratedCode(
          "supplierCode"
        );


        await refreshDoc();


        await syncSupplier();


        break;

      }


      /*
       * LOCATION
       */

      case WF.LOCATIONS: {

        await resolveLocationCustomer();


        await refreshDoc();


        await assignLocationCode();


        await refreshDoc();


        await syncLocation();


        break;

      }


      /*
       * PRODUCT
       */

      case WF.PRODUCT_CATALOG: {

        await resolveProductSupplier();


        await refreshDoc();


        await assignGeneratedCode(
          "productCode"
        );


        await refreshDoc();


        await syncProduct();


        break;

      }


      /*
       * INSTALLED MACHINE
       */

      case WF.INSTALLED_MACHINES: {

        await assignGeneratedCode(
          "machineId"
        );


        await refreshDoc();


        await resolveMachineFields();


        await refreshDoc();


        await syncMachine();


        break;

      }


      /*
       * AGREEMENT / WARRANTY
       */

      case WF.AGREEMENT_WARRANTY: {

        console.log(
          "============================================"
        );


        console.log(
          "AGREEMENT / WARRANTY PROCESS START"
        );


        await resolveAgreementFields();


        console.log(
          "AGREEMENT / WARRANTY PROCESS END"
        );


        console.log(
          "============================================"
        );


        break;

      }


      default: {

        console.log(
          "Ignored workflow:",
          workflowId
        );


        break;

      }

    }


    console.log(
      "============================================"
    );


    console.log(
      "DIPRA MASTER DATA SYNC COMPLETED"
    );


    console.log(
      "============================================"
    );


    return {

      success:
        true,

      workflow:
        workflowId,

      operation:
        operation

    };


  } catch (error) {

    console.log(
      "============================================"
    );


    console.log(
      "DIPRA MASTER DATA SYNC ERROR"
    );


    console.log(
      "Message:",
      error.message
    );


    if (
      error.stack
    ) {

      console.log(
        error.stack
      );

    }


    console.log(
      "============================================"
    );


    throw error;

  }

};