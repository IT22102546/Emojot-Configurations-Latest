exports = async function (changeEvent) {

  console.log("============================================");
  console.log("DIPRA MASTER DATA SYNC START");
  console.log("============================================");


  /*
   * ============================================================
   * CONFIGURATION
   * ============================================================
   */

  const SERVICE_NAME = "Emojot-dev-New2";

  const COMPANY_ID = "59747e53cd90e9231b90de48";

  const INCIDENTS_DATABASE =
    "emojot_59747e53cd90e9231b90de48";

  const WORKFLOWS_DATABASE =
    "emojot";

  const INCIDENTS_COLLECTION =
    "Incidents";

  const WORKFLOWS_COLLECTION =
    "IncidentWorkflows";


  /*
   * ============================================================
   * WORKFLOW IDS
   * ============================================================
   */

  const WF = {

    CUSTOMERS:
      "6aa0f91dfedc939c69bca6e6",

    SUPPLIERS:
      "6aa0f9a2fedc939c69bca6ea",

    PRODUCT_CATALOG:
      "6aa0f988fedc939c69bca6e8",

    LOCATIONS:
      "6aa0f960fedc939c69bca6e7",

    INSTALLED_MACHINES:
      "6aa0f93c43808b90bfceec95",

    AGREEMENT_WARRANTY:
      "6aa0f8fdfedc939c69bca6e5"

  };


  /*
   * ============================================================
   * BASIC HELPERS
   * ============================================================
   */

  function oid(id) {

    return new BSON.ObjectId(id);

  }


  function workflowValues(id) {

    const values = [
      id
    ];


    try {

      values.push(
        oid(id)
      );

    } catch (e) {

      // Ignore invalid ObjectId.

    }


    return values;

  }


  function cleanObject(obj) {

    const result = {};


    Object.keys(obj).forEach(
      function (key) {

        if (
          obj[key] !== undefined &&
          obj[key] !== null
        ) {

          result[key] =
            obj[key];

        }

      }
    );


    return result;

  }


  /*
   * ============================================================
   * DATABASE
   * ============================================================
   */

  const mongo =
    context.services.get(
      SERVICE_NAME
    );


  if (
    !mongo ||
    typeof mongo.db !== "function"
  ) {

    throw new Error(
      "MongoDB service unavailable: " +
      SERVICE_NAME
    );

  }


  const incidents =
    mongo
      .db(INCIDENTS_DATABASE)
      .collection(INCIDENTS_COLLECTION);


  const workflows =
    mongo
      .db(WORKFLOWS_DATABASE)
      .collection(WORKFLOWS_COLLECTION);


  /*
   * ============================================================
   * SELECTOR OPTION
   * ============================================================
   */

  function buildOption(
    id,
    name,
    changingFields
  ) {

    return {

      id:
        id,

      name:
        name,

      triggers: [
        {
          channel:
            "fieldChange",

          changingFields:
            changingFields || []
        }
      ]

    };

  }


  /*
   * ============================================================
   * REPLACE SELECTOR VALUES
   * ============================================================
   */

  async function replaceSelectorValues(
    workflowId,
    field,
    options,
    label
  ) {

    const path =
      "customFields." +
      field +
      ".values";


    const update = {};


    update[path] =
      options;


    /*
     * Keep this scoped to exact workflow.
     * No updateMany.
     */

    const result =
      await workflows.updateOne(

        {
          _id:
            oid(workflowId)
        },

        {
          $set:
            update
        }

      );


    console.log(
      label,
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount,
      "| options:",
      options.length
    );


    return result;

  }


  /*
   * ============================================================
   * UPSERT ONE SELECTOR OPTION
   * ============================================================
   */

  async function upsertSelectorOption(
    workflowId,
    field,
    option,
    label
  ) {

    if (
      !option ||
      !option.id
    ) {

      return;

    }


    const path =
      "customFields." +
      field +
      ".values";


    const pull = {};


    pull[path] = {
      id:
        option.id
    };


    await workflows.updateOne(

      {
        _id:
          oid(workflowId)
      },

      {
        $pull:
          pull
      }

    );


    const push = {};


    push[path] =
      option;


    const result =
      await workflows.updateOne(

        {
          _id:
            oid(workflowId)
        },

        {
          $push:
            push
        }

      );


    console.log(
      label,
      "| option:",
      option.id,
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount
    );

  }


  /*
   * ============================================================
   * MANUAL RUN
   *
   * IMPORTANT:
   * This rebuilds AGREEMENT/WARRANTY selectors only.
   *
   * It does NOT replace selector arrays in:
   * - Customer
   * - Supplier
   * - Product
   * - Location
   * - Installed Machine
   * ============================================================
   */

  if (
    !changeEvent ||
    !changeEvent.operationType
  ) {

    console.log("============================================");
    console.log("AGREEMENT SELECTOR REBUILD START");
    console.log("============================================");


    /*
     * ==========================================================
     * CUSTOMER OPTIONS
     * ==========================================================
     */

    const customers =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.CUSTOMERS
            )
        },

        customerCode: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        },

        customerName: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const customerOptions = [];

    const seenCustomers = {};


    customers.forEach(
      function (customer) {

        const code =
          String(
            customer.customerCode || ""
          ).trim();


        const name =
          String(
            customer.customerName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenCustomers[code]
        ) {

          return;

        }


        seenCustomers[code] =
          true;


        customerOptions.push(

          buildOption(

            code,

            name,

            [
              {
                id:
                  "customerCode",

                value:
                  code
              },

              {
                id:
                  "customerName",

                value:
                  name
              }
            ]

          )

        );

      }
    );


    customerOptions.sort(
      function (a, b) {

        return a.name.localeCompare(
          b.name
        );

      }
    );


    /*
     * ==========================================================
     * SUPPLIER OPTIONS
     * ==========================================================
     */

    const suppliers =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.SUPPLIERS
            )
        },

        supplierCode: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        },

        supplierName: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const supplierOptions = [];

    const seenSuppliers = {};


    suppliers.forEach(
      function (supplier) {

        const code =
          String(
            supplier.supplierCode || ""
          ).trim();


        const name =
          String(
            supplier.supplierName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenSuppliers[code]
        ) {

          return;

        }


        seenSuppliers[code] =
          true;


        supplierOptions.push(

          buildOption(

            code,

            name,

            [
              {
                id:
                  "supplierCode",

                value:
                  code
              },

              {
                id:
                  "supplierName",

                value:
                  name
              }
            ]

          )

        );

      }
    );


    supplierOptions.sort(
      function (a, b) {

        return a.name.localeCompare(
          b.name
        );

      }
    );


    /*
     * ==========================================================
     * PRODUCT OPTIONS
     * ==========================================================
     */

    const products =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.PRODUCT_CATALOG
            )
        },

        productCode: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        },

        productName: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const productOptions = [];

    const seenProducts = {};


    products.forEach(
      function (product) {

        const code =
          String(
            product.productCode || ""
          ).trim();


        const name =
          String(
            product.productName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenProducts[code]
        ) {

          return;

        }


        seenProducts[code] =
          true;


        const changingFields = [

          {
            id:
              "productCode",

            value:
              code
          },

          {
            id:
              "productName",

            value:
              name
          }

        ];


        if (
          product.supplierCode
        ) {

          changingFields.push({

            id:
              "supplierCode",

            value:
              product.supplierCode

          });

        }


        if (
          product.supplierName
        ) {

          changingFields.push({

            id:
              "supplierName",

            value:
              product.supplierName

          });

        }


        productOptions.push(

          buildOption(

            code,

            name,

            changingFields

          )

        );

      }
    );


    productOptions.sort(
      function (a, b) {

        return a.name.localeCompare(
          b.name
        );

      }
    );


    /*
     * ==========================================================
     * LOCATION OPTIONS
     * ==========================================================
     */

    const locations =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.LOCATIONS
            )
        },

        locationCode: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        },

        locationName: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const locationOptions = [];

    const seenLocations = {};


    locations.forEach(
      function (location) {

        const code =
          String(
            location.locationCode || ""
          ).trim();


        const name =
          String(
            location.locationName || ""
          ).trim();


        if (
          !code ||
          !name ||
          seenLocations[code]
        ) {

          return;

        }


        seenLocations[code] =
          true;


        const changingFields = [

          {
            id:
              "locationCode",

            value:
              code
          },

          {
            id:
              "locationName",

            value:
              name
          }

        ];


        if (
          location.customerCode
        ) {

          changingFields.push({

            id:
              "customerCode",

            value:
              location.customerCode

          });

        }


        if (
          location.customerName
        ) {

          changingFields.push({

            id:
              "customerName",

            value:
              location.customerName

          });

        }


        locationOptions.push(

          buildOption(

            code,

            name,

            changingFields

          )

        );

      }
    );


    locationOptions.sort(
      function (a, b) {

        return a.name.localeCompare(
          b.name
        );

      }
    );


    /*
     * ==========================================================
     * INSTALLED MACHINE OPTIONS
     *
     * IMPORTANT:
     *
     * serialNumber is the enum field.
     *
     * We use machineId as stable option id,
     * display serialNumber as option name.
     *
     * Selecting it fills all related code fields.
     * ==========================================================
     */

    const machines =
      await incidents.find({

        workflow: {
          $in:
            workflowValues(
              WF.INSTALLED_MACHINES
            )
        },

        machineId: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        },

        serialNumber: {
          $exists: true,
          $nin: [
            null,
            ""
          ]
        }

      }).toArray();


    const machineOptions = [];

    const seenMachines = {};


    machines.forEach(
      function (machine) {

        const machineId =
          String(
            machine.machineId || ""
          ).trim();


        const serialNumber =
          String(
            machine.serialNumber || ""
          ).trim();


        if (
          !machineId ||
          !serialNumber ||
          seenMachines[machineId]
        ) {

          return;

        }


        seenMachines[machineId] =
          true;


        const changingFields = [

          {
            id:
              "machineId",

            value:
              machineId
          },

          {
            id:
              "serialNumber",

            value:
              serialNumber
          }

        ];


        if (
          machine.productCode
        ) {

          changingFields.push({

            id:
              "productCode",

            value:
              machine.productCode

          });

        }


        if (
          machine.productName
        ) {

          changingFields.push({

            id:
              "productName",

            value:
              machine.productName

          });

        }


        if (
          machine.customerCode
        ) {

          changingFields.push({

            id:
              "customerCode",

            value:
              machine.customerCode

          });

        }


        if (
          machine.customerName
        ) {

          changingFields.push({

            id:
              "customerName",

            value:
              machine.customerName

          });

        }


        if (
          machine.locationCode
        ) {

          changingFields.push({

            id:
              "locationCode",

            value:
              machine.locationCode

          });

        }


        if (
          machine.locationName
        ) {

          changingFields.push({

            id:
              "locationName",

            value:
              machine.locationName

          });

        }


        if (
          machine.supplierCode
        ) {

          changingFields.push({

            id:
              "supplierCode",

            value:
              machine.supplierCode

          });

        }


        if (
          machine.supplierName
        ) {

          changingFields.push({

            id:
              "supplierName",

            value:
              machine.supplierName

          });

        }


        machineOptions.push(

          buildOption(

            machineId,

            serialNumber,

            changingFields

          )

        );

      }
    );


    machineOptions.sort(
      function (a, b) {

        return a.name.localeCompare(
          b.name
        );

      }
    );


    /*
     * ==========================================================
     * WRITE AGREEMENT SELECTORS
     * ==========================================================
     */

    await replaceSelectorValues(
      WF.AGREEMENT_WARRANTY,
      "customerName",
      customerOptions,
      "AGREEMENT CUSTOMER"
    );


    await replaceSelectorValues(
      WF.AGREEMENT_WARRANTY,
      "supplierName",
      supplierOptions,
      "AGREEMENT SUPPLIER"
    );


    await replaceSelectorValues(
      WF.AGREEMENT_WARRANTY,
      "productName",
      productOptions,
      "AGREEMENT PRODUCT"
    );


    await replaceSelectorValues(
      WF.AGREEMENT_WARRANTY,
      "locationName",
      locationOptions,
      "AGREEMENT LOCATION"
    );


    await replaceSelectorValues(
      WF.AGREEMENT_WARRANTY,
      "serialNumber",
      machineOptions,
      "AGREEMENT MACHINE"
    );


    console.log("============================================");
    console.log("AGREEMENT SELECTOR REBUILD COMPLETE");
    console.log("============================================");


    return {

      success:
        true,

      manualRun:
        true,

      agreementOnly:
        true,

      customerOptions:
        customerOptions.length,

      supplierOptions:
        supplierOptions.length,

      productOptions:
        productOptions.length,

      locationOptions:
        locationOptions.length,

      machineOptions:
        machineOptions.length

    };

  }


  /*
   * ============================================================
   * EVENT VALIDATION
   * ============================================================
   */

  const operation =
    changeEvent.operationType;


  if (
    operation !== "insert" &&
    operation !== "update" &&
    operation !== "replace"
  ) {

    return;

  }


  if (
    !changeEvent.ns ||
    changeEvent.ns.coll !==
      INCIDENTS_COLLECTION
  ) {

    return;

  }


  let doc =
    changeEvent.fullDocument;


  if (!doc) {

    console.log(
      "fullDocument unavailable."
    );


    return;

  }


  let workflowId =
    doc.workflow
      ? doc.workflow.toString()
      : "";


  if (!workflowId) {

    return;

  }


  console.log(
    "Operation:",
    operation
  );


  console.log(
    "Workflow:",
    workflowId
  );


  /*
   * ============================================================
   * DOCUMENT HELPERS
   * ============================================================
   */

  function get(field) {

    return doc[field];

  }


  async function refreshDoc() {

    const latest =
      await incidents.findOne({

        _id:
          doc._id

      });


    if (latest) {

      doc =
        latest;


      workflowId =
        doc.workflow
          ? doc.workflow.toString()
          : workflowId;

    }


    return doc;

  }


  async function updateCurrent(
    fields,
    label
  ) {

    const update =
      cleanObject(
        fields
      );


    if (
      Object.keys(
        update
      ).length === 0
    ) {

      return false;

    }


    const result =
      await incidents.updateOne(

        {
          _id:
            doc._id
        },

        {
          $set:
            update
        }

      );


    Object.keys(
      update
    ).forEach(
      function (field) {

        doc[field] =
          update[field];

      }
    );


    console.log(
      label || "CURRENT UPDATE",
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount
    );


    return (
      result.matchedCount === 1
    );

  }


  /*
   * ============================================================
   * TITLE
   * ============================================================
   */

  async function refreshTitle(
    code
  ) {

    if (!code) {

      return;

    }


    const updates = {};


    [
      "name",
      "title",
      "incidentName"
    ].forEach(
      function (field) {

        const current =
          get(
            field
          );


        if (
          typeof current !== "string"
        ) {

          return;

        }


        const corrected =
          current.replace(

            /^(#\s*)?N\/A(?=\s*-)/i,

            function (
              match,
              prefix
            ) {

              return (
                prefix || ""
              ) +
              code;

            }

          );


        if (
          corrected !== current
        ) {

          updates[field] =
            corrected;

        }

      }
    );


    if (
      Object.keys(
        updates
      ).length > 0
    ) {

      await updateCurrent(
        updates,
        "TITLE UPDATE"
      );

    }

  }


  /*
   * ============================================================
   * GENERATED CODE
   * ============================================================
   */

  async function assignGeneratedCode(
    field
  ) {

    await refreshDoc();


    const current =
      String(
        get(field) || ""
      ).trim();


    if (current) {

      return current;

    }


    const incidentKey =
      String(
        get(
          "incidentKey"
        ) || ""
      ).trim();


    if (!incidentKey) {

      console.log(
        "NO INCIDENT KEY FOR:",
        field
      );


      return "";

    }


    await updateCurrent(

      {
        [field]:
          incidentKey
      },

      "ASSIGN " + field

    );


    await refreshDoc();


    const saved =
      String(
        get(field) || ""
      ).trim();


    await refreshTitle(
      saved
    );


    return saved;

  }


  /*
   * ============================================================
   * CUSTOMER SYNC
   * ============================================================
   */

  async function syncCustomer() {

    await refreshDoc();


    const code =
      String(
        get(
          "customerCode"
        ) || ""
      ).trim();


    const name =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (
      !code ||
      !name
    ) {

      return;

    }


    const option =
      buildOption(

        code,

        name,

        [
          {
            id:
              "customerCode",

            value:
              code
          },

          {
            id:
              "customerName",

            value:
              name
          }
        ]

      );


    await upsertSelectorOption(
      WF.LOCATIONS,
      "customerName",
      option,
      "LOCATION CUSTOMER"
    );


    await upsertSelectorOption(
      WF.INSTALLED_MACHINES,
      "customerName",
      option,
      "MACHINE CUSTOMER"
    );


    await upsertSelectorOption(
      WF.AGREEMENT_WARRANTY,
      "customerName",
      option,
      "AGREEMENT CUSTOMER"
    );

  }


  /*
   * ============================================================
   * SUPPLIER SYNC
   * ============================================================
   */

  async function syncSupplier() {

    await refreshDoc();


    const code =
      String(
        get(
          "supplierCode"
        ) || ""
      ).trim();


    const name =
      String(
        get(
          "supplierName"
        ) || ""
      ).trim();


    if (
      !code ||
      !name
    ) {

      return;

    }


    const option =
      buildOption(

        code,

        name,

        [
          {
            id:
              "supplierCode",

            value:
              code
          },

          {
            id:
              "supplierName",

            value:
              name
          }
        ]

      );


    await upsertSelectorOption(
      WF.PRODUCT_CATALOG,
      "supplierName",
      option,
      "PRODUCT SUPPLIER"
    );


    await upsertSelectorOption(
      WF.INSTALLED_MACHINES,
      "supplierName",
      option,
      "MACHINE SUPPLIER"
    );


    await upsertSelectorOption(
      WF.AGREEMENT_WARRANTY,
      "supplierName",
      option,
      "AGREEMENT SUPPLIER"
    );

  }


  /*
   * ============================================================
   * LOCATION CUSTOMER RESOLUTION
   * ============================================================
   */

  async function resolveLocationCustomer() {

    await refreshDoc();


    const selected =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (!selected) {

      return;

    }


    const customer =
      await incidents.findOne({

        workflow: {
          $in:
            workflowValues(
              WF.CUSTOMERS
            )
        },

        $or: [
          {
            customerCode:
              selected
          },
          {
            customerName:
              selected
          }
        ]

      });


    if (!customer) {

      return;

    }


    await updateCurrent(

      {
        customerCode:
          customer.customerCode
      },

      "LOCATION CUSTOMER CODE"

    );

  }


  /*
   * ============================================================
   * LOCATION CODE
   * ============================================================
   */

  async function assignLocationCode() {

    await refreshDoc();


    const customerCode =
      String(
        get(
          "customerCode"
        ) || ""
      ).trim();


    const incidentKey =
      String(
        get(
          "incidentKey"
        ) || ""
      ).trim();


    if (!incidentKey) {

      return;

    }


    let locationCode =
      incidentKey;


    if (
      customerCode &&
      incidentKey.indexOf(
        "_L"
      ) === 0
    ) {

      locationCode =
        customerCode +
        incidentKey;

    }


    await updateCurrent(

      {
        locationCode:
          locationCode,

        incidentKey:
          locationCode
      },

      "LOCATION CODE"

    );


    await refreshTitle(
      locationCode
    );


    return locationCode;

  }


  /*
   * ============================================================
   * LOCATION SYNC
   * ============================================================
   */

  async function syncLocation() {

    await refreshDoc();


    const code =
      String(
        get(
          "locationCode"
        ) || ""
      ).trim();


    const name =
      String(
        get(
          "locationName"
        ) || ""
      ).trim();


    if (
      !code ||
