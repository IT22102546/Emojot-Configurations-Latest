  /*
   * ============================================================
   * MACHINE SYNC TO AGREEMENT
   * ============================================================
   */

  async function syncMachine() {

    await refreshDoc();


    const machineId =
      String(
        get(
          "machineId"
        ) || ""
      ).trim();


    const serial =
      String(
        get(
          "serialNumber"
        ) || ""
      ).trim();


    if (
      !machineId ||
      !serial
    ) {

      return;

    }


    const fields = [

      {
        id:
          "machineId",

        value:
          machineId
      },

      {
        id:
          "serialNumber",

        value:
          serial
      }

    ];


    [
      "productCode",
      "productName",
      "customerCode",
      "customerName",
      "locationCode",
      "locationName",
      "supplierCode",
      "supplierName"
    ].forEach(
      function (field) {

        const value =
          get(field);


        if (
          value !== undefined &&
          value !== null &&
          value !== ""
        ) {

          fields.push({

            id:
              field,

            value:
              value

          });

        }

      }
    );


    const option =
      buildOption(

        machineId,

        serial,

        fields

      );


    await upsertSelectorOption(
      WF.AGREEMENT_WARRANTY,
      "serialNumber",
      option,
      "AGREEMENT MACHINE"
    );

  }


  /*
