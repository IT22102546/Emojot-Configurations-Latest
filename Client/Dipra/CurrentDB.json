exports = async function (changeEvent) {

  console.log("============================================");
  console.log("DIPRA MASTER DATA SYNC START");
  console.log("============================================");


  /*
   * ============================================================
   * CONFIGURATION
   * ============================================================
   */

  const SERVICE_NAME =
    "Emojot-dev-New2";

  const COMPANY_ID =
    "59747e53cd90e9231b90de48";

  const INCIDENTS_DATABASE =
    "emojot_59747e53cd90e9231b90de48";

  const WORKFLOWS_DATABASE =
    "emojot";

  const INCIDENTS_COLLECTION =
    "Incidents";

  const WORKFLOWS_COLLECTION =
    "IncidentWorkflows";


  /*
   * ============================================================
   * WORKFLOW IDS
   * ============================================================
   */

  const WF = {

    SUPPLIERS:
      "6aa0f9a2fedc939c69bca6ea",

    PRODUCT_CATALOG:
      "6aa0f988fedc939c69bca6e8",

    LOCATIONS:
      "6aa0f960fedc939c69bca6e7",

    INSTALLED_MACHINES:
      "6aa0f93c43808b90bfceec95",

    CUSTOMERS:
      "6aa0f91dfedc939c69bca6e6",

    AGREEMENT_WARRANTY:
      "6aa0f8fdfedc939c69bca6e5"

  };


  /*
   * ============================================================
   * HELPERS
   * ============================================================
   */

  function oid(id) {

    return new BSON.ObjectId(id);

  }


  function workflowValues(id) {

    const values = [
      id
    ];


    try {

      values.push(
        oid(id)
      );

    } catch (e) {

      // ignore

    }


    return values;

  }


  function cleanObject(obj) {

    const result = {};


    Object.keys(obj).forEach(
      function (key) {

        if (
          obj[key] !== undefined &&
          obj[key] !== null
        ) {

          result[key] =
            obj[key];

        }

      }
    );


    return result;

  }


  /*
   * ============================================================
   * DATABASE
   * ============================================================
   */

  const mongo =
    context.services.get(
      SERVICE_NAME
    );


  if (
    !mongo ||
    typeof mongo.db !== "function"
  ) {

    throw new Error(
      "MongoDB service unavailable: " +
      SERVICE_NAME
    );

  }


  const incidents =
    mongo
      .db(INCIDENTS_DATABASE)
      .collection(INCIDENTS_COLLECTION);


  const workflows =
    mongo
      .db(WORKFLOWS_DATABASE)
      .collection(WORKFLOWS_COLLECTION);


  /*
   * ============================================================
   * DROPDOWN SOURCES
   *
   * Every dropdown is rebuilt from the Incidents database.
   * The workflow only keeps the result of the latest query, so
   * deleted / renamed records disappear instead of piling up.
   *
   * Options are plain { id, name }. Codes and details of the
   * selected record are filled after save by the resolve*
   * functions below, not by option triggers.
   *
   * source       : workflow whose incidents feed the dropdown
   * idField      : incident field used as option id
   * nameField    : incident field shown in the dropdown
   * targets      : workflows that show this dropdown
   * ============================================================
   */

  const SELECTORS = {

    customerName: {
      source: WF.CUSTOMERS,
      idField: "customerCode",
      nameField: "customerName",
      targets: [
        WF.LOCATIONS,
        WF.INSTALLED_MACHINES,
        WF.AGREEMENT_WARRANTY
      ]
    },

    supplierName: {
      source: WF.SUPPLIERS,
      idField: "supplierCode",
      nameField: "supplierName",
      targets: [
        WF.PRODUCT_CATALOG,
        WF.INSTALLED_MACHINES,
        WF.AGREEMENT_WARRANTY
      ]
    },

    locationName: {
      source: WF.LOCATIONS,
      idField: "locationCode",
      nameField: "locationName",
      targets: [
        WF.INSTALLED_MACHINES,
        WF.AGREEMENT_WARRANTY
      ]
    },

    productName: {
      source: WF.PRODUCT_CATALOG,
      idField: "productCode",
      nameField: "productName",
      targets: [
        WF.INSTALLED_MACHINES,
        WF.AGREEMENT_WARRANTY
      ]
    },

    serialNumber: {
      source: WF.INSTALLED_MACHINES,
      idField: "machineId",
      nameField: "serialNumber",
      targets: [
        WF.AGREEMENT_WARRANTY
      ]
    }

  };


  /*
   * ============================================================
   * SOURCE FIELDS
   *
   * Incident fields a dropdown reads. Used to fetch only these
   * fields and to skip rebuilds when none of them changed.
   * ============================================================
   */

  function sourceFields(
    selectorField
  ) {

    const config =
      SELECTORS[selectorField];


    return [
      config.idField,
      config.nameField
    ];

  }


  /*
   * ============================================================
   * LOAD DROPDOWN OPTIONS FROM DB
   * ============================================================
   */

  async function loadOptions(
    selectorField
  ) {

    const config =
      SELECTORS[selectorField];


    const query = {

      workflow: {
        $in:
          workflowValues(
            config.source
          )
      }

    };


    query[config.idField] = {
      $exists: true,
      $nin: [null, ""]
    };


    query[config.nameField] = {
      $exists: true,
      $nin: [null, ""]
    };


    const projection = {
      _id: 0
    };


    sourceFields(
      selectorField
    ).forEach(
      function (field) {

        projection[field] =
          1;

      }
    );


    const records =
      await incidents.find(
        query,
        projection
      ).toArray();


    const options = [];

    const seen = {};


    records.forEach(
      function (record) {

        const id =
          String(
            record[config.idField] || ""
          ).trim();


        const name =
          String(
            record[config.nameField] || ""
          ).trim();


        if (
          !id ||
          !name ||
          seen[id]
        ) {

          return;

        }


        seen[id] =
          true;


        options.push({

          id:
            id,

          name:
            name

        });

      }
    );


    options.sort(
      function (a, b) {

        return String(
          a.name
        ).localeCompare(
          String(
            b.name
          )
        );

      }
    );


    return options;

  }


  /*
   * ============================================================
   * REFRESH DROPDOWN IN TARGET WORKFLOWS
   *
   * Replaces customFields.<field>.values with the fresh DB list.
   * ============================================================
   */

  async function refreshSelector(
    selectorField
  ) {

    const config =
      SELECTORS[selectorField];


    const options =
      await loadOptions(
        selectorField
      );


    const set = {};


    set[
      "customFields." +
      selectorField +
      ".values"
    ] =
      options;


    const result =
      await workflows.updateMany(

        {
          _id: {
            $in:
              config.targets.map(
                oid
              )
          },

          companyID:
            COMPANY_ID
        },

        {
          $set:
            set
        }

      );


    const sizeKB =
      Math.round(
        JSON.stringify(
          options
        ).length / 1024
      );


    console.log(
      "DROPDOWN REFRESH:",
      selectorField,
      "| options:",
      options.length,
      "| size KB:",
      sizeKB,
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount
    );


    if (
      sizeKB > 4096
    ) {

      console.log(
        "WARNING: dropdown",
        selectorField,
        "is over 4 MB. Workflow documents are limited to 16 MB."
      );

    }


    return options.length;

  }


  /*
   * ============================================================
   * RECORD STATUS
   *
   * Master data and machine records are only Active / Inactive
   * and start as Active. Anything else (e.g. the old Draft)
   * becomes Active. Agreements keep their own approval flow
   * (Draft -> Pending Approval -> Active -> ...) and are not
   * touched here.
   *
   * Keep in sync with status.values in these *_WF.json files.
   * ============================================================
   */

  const MASTER_STATUS_WORKFLOWS = [
    WF.CUSTOMERS,
    WF.SUPPLIERS,
    WF.LOCATIONS,
    WF.PRODUCT_CATALOG,
    WF.INSTALLED_MACHINES
  ];

  const MASTER_STATUSES = [
    "Active",
    "Inactive"
  ];


  async function activateLegacyMasterStatuses() {

    const ids = [];


    MASTER_STATUS_WORKFLOWS.forEach(
      function (id) {

        workflowValues(id).forEach(
          function (value) {

            ids.push(value);

          }
        );

      }
    );


    const result =
      await incidents.updateMany(

        {
          workflow: {
            $in:
              ids
          },

          status: {
            $nin:
              MASTER_STATUSES
          }
        },

        {
          $set: {
            status:
              "Active"
          }
        }

      );


    console.log(
      "MASTER STATUS -> Active",
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount
    );


    return result.modifiedCount;

  }


  /*
   * ============================================================
   * MANUAL RUN
   *
   * Rebuilds every dropdown in every workflow from the DB and
   * moves master data records off legacy statuses.
   * ============================================================
   */

  if (
    !changeEvent ||
    !changeEvent.operationType
  ) {

    console.log("============================================");
    console.log("DROPDOWN REBUILD START");
    console.log("============================================");


    const counts = {};


    for (
      const selectorField of
      Object.keys(
        SELECTORS
      )
    ) {

      counts[selectorField] =
        await refreshSelector(
          selectorField
        );

    }


    const activated =
      await activateLegacyMasterStatuses();


    console.log("============================================");
    console.log("DROPDOWN REBUILD COMPLETE");
    console.log("============================================");


    return {

      success:
        true,

      manualRun:
        true,

      options:
        counts,

      activated:
        activated

    };

  }


  /*
   * ============================================================
   * EVENT VALIDATION
   * ============================================================
   */

  const operation =
    changeEvent.operationType;


  if (
    operation !== "insert" &&
    operation !== "update" &&
    operation !== "replace"
  ) {

    return;

  }


  if (
    !changeEvent.ns ||
    changeEvent.ns.coll !==
      INCIDENTS_COLLECTION
  ) {

    return;

  }


  let doc =
    changeEvent.fullDocument;


  if (!doc) {

    console.log(
      "fullDocument missing."
    );


    return;

  }


  let workflowId =
    doc.workflow
      ? doc.workflow.toString()
      : "";


  if (!workflowId) {

    return;

  }


  console.log(
    "Operation:",
    operation
  );


  console.log(
    "Workflow:",
    workflowId
  );


  /*
   * ============================================================
   * DOCUMENT HELPERS
   * ============================================================
   */

  function get(field) {

    return doc[field];

  }


  async function refreshDoc() {

    const latest =
      await incidents.findOne({

        _id:
          doc._id

      });


    if (latest) {

      doc =
        latest;


      workflowId =
        doc.workflow
          ? doc.workflow.toString()
          : workflowId;

    }


    return doc;

  }


  async function updateCurrent(
    fields,
    label
  ) {

    const update =
      cleanObject(
        fields
      );


    if (
      Object.keys(
        update
      ).length === 0
    ) {

      return false;

    }


    const result =
      await incidents.updateOne(

        {
          _id:
            doc._id
        },

        {
          $set:
            update
        }

      );


    Object.keys(
      update
    ).forEach(
      function (field) {

        doc[field] =
          update[field];

      }
    );


    console.log(
      label || "CURRENT INCIDENT UPDATE",
      "| matched:",
      result.matchedCount,
      "| modified:",
      result.modifiedCount
    );


    return (
      result.matchedCount === 1
    );

  }


  /*
   * ============================================================
   * TITLE
   *
   * The platform builds the title from nameTemplate only when a
   * record is created. Rebuild it on every save so renames and
   * newly assigned codes show in the list view.
   *
   * Keep these in sync with nameTemplate in each *_WF.json.
   * ============================================================
   */

  const TITLE_TEMPLATES = {};

  TITLE_TEMPLATES[WF.CUSTOMERS] =
    "$customerCode$ - $customerName$";

  TITLE_TEMPLATES[WF.SUPPLIERS] =
    "$supplierCode$ - $supplierName$";

  TITLE_TEMPLATES[WF.LOCATIONS] =
    "$locationCode$ - $locationName$";

  TITLE_TEMPLATES[WF.PRODUCT_CATALOG] =
    "$productCode$ - $productName$";

  TITLE_TEMPLATES[WF.INSTALLED_MACHINES] =
    "$machineId$ - $serialNumber$";

  TITLE_TEMPLATES[WF.AGREEMENT_WARRANTY] =
    "$agreementNumber$ - $customerName$";


  /*
   * Same for descriptionTemplate: built at creation, before the
   * trigger has filled e.g. machineId, so it showed "N/A".
   * Product is left out: its template is its own description field.
   */

  const DESCRIPTION_TEMPLATES = {};

  DESCRIPTION_TEMPLATES[WF.INSTALLED_MACHINES] =
    "$productName$ at $locationName$";

  DESCRIPTION_TEMPLATES[WF.AGREEMENT_WARRANTY] =
    "$agreementType$ for machine $machineId$";


  /*
   * A dropdown field (e.g. customerName on an agreement) may hold
   * the selected option id. Show the source record's name instead.
   */

  async function displayValue(
    field
  ) {

    const raw =
      get(
        field
      );


    const value =
      raw === undefined ||
      raw === null
        ? ""
        : String(
            raw
          ).trim();


    const config =
      SELECTORS[field];


    if (
      !value ||
      !config ||
      config.source === workflowId
    ) {

      return value;

    }


    const lookup = {
      $or: [
        {},
        {}
      ]
    };


    lookup.workflow = {
      $in:
        workflowValues(
          config.source
        )
    };


    lookup.$or[0][config.idField] =
      value;


    lookup.$or[1][config.nameField] =
      value;


    const record =
      await incidents.findOne(
        lookup
      );


    if (
      record &&
      record[config.nameField]
    ) {

      return String(
        record[config.nameField]
      ).trim();

    }


    return value;

  }


  async function refreshTitle() {

    await refreshDoc();


    async function render(template) {

      const tokens =
        template.match(
          /\$[A-Za-z0-9_]+\$/g
        ) || [];


      let text =
        template;


      for (
        const token of
        tokens
      ) {

        const value =
          await displayValue(
            token.slice(1, -1)
          );


        text =
          text.split(
            token
          ).join(
            value || "N/A"
          );

      }


      return text;

    }


    const updates = {};


    const descriptionTemplate =
      DESCRIPTION_TEMPLATES[workflowId];


    if (descriptionTemplate) {

      const description =
        await render(
          descriptionTemplate
        );


      if (
        description !==
          get("description")
      ) {

        updates.description =
          description;

      }

    }


    const template =
      TITLE_TEMPLATES[workflowId];


    if (!template) {

      await updateCurrent(
        updates,
        "DESCRIPTION UPDATE"
      );


      return;

    }


    const title =
      await render(
        template
      );


    [
      "name",
      "title",
      "incidentName"
    ].forEach(
      function (field) {

        const current =
          get(
            field
          );


        if (
          typeof current !== "string"
        ) {

          return;

        }


        const prefix =
          (
            current.match(
              /^#\s*/
            ) || [""]
          )[0];


        const corrected =
          prefix +
          title;


        if (
          corrected !== current
        ) {

          updates[
            field
          ] =
            corrected;

        }

      }
    );


    await updateCurrent(
      updates,
      "TITLE / DESCRIPTION UPDATE"
    );

  }


  /*
   * ============================================================
   * GENERATED CODE
   * ============================================================
   */

  async function assignGeneratedCode(
    field
  ) {

    await refreshDoc();


    const current =
      String(
        get(field) || ""
      ).trim();


    if (current) {

      return current;

    }


    const incidentKey =
      String(
        get(
          "incidentKey"
        ) || ""
      ).trim();


    if (!incidentKey) {

      return "";

    }


    await updateCurrent(

      {
        [field]:
          incidentKey
      },

      "ASSIGN " + field

    );


    await refreshDoc();


    const saved =
      String(
        get(field) || ""
      ).trim();


    return saved;

  }


  /*
   * ============================================================
   * LOCATION CUSTOMER
   * ============================================================
   */

  async function resolveLocationCustomer() {

    await refreshDoc();


    const selected =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (!selected) {

      return;

    }


    const customer =
      await incidents.findOne({

        workflow: {
          $in:
            workflowValues(
              WF.CUSTOMERS
            )
        },

        $or: [
          {
            customerCode:
              selected
          },
          {
            customerName:
              selected
          }
        ]

      });


    if (!customer) {

      return;

    }


    await updateCurrent(

      {
        customerCode:
          customer.customerCode
      },

      "LOCATION CUSTOMER CODE"

    );

  }


  /*
   * ============================================================
   * PRODUCT SUPPLIER
   * ============================================================
   */

  async function resolveProductSupplier() {

    await refreshDoc();


    const selected =
      String(
        get(
          "supplierName"
        ) || ""
      ).trim();


    if (!selected) {

      return;

    }


    const supplier =
      await incidents.findOne({

        workflow: {
          $in:
            workflowValues(
              WF.SUPPLIERS
            )
        },

        $or: [
          {
            supplierCode:
              selected
          },
          {
            supplierName:
              selected
          }
        ]

      });


    if (!supplier) {

      return;

    }


    await updateCurrent(

      {
        supplierCode:
          supplier.supplierCode
      },

      "PRODUCT SUPPLIER CODE"

    );

  }



  /*
   * ============================================================
   * MACHINE FIELD RESOLUTION
   * ============================================================
   */

  async function resolveMachineFields() {

    await refreshDoc();


    const updates = {};


    /*
     * PRODUCT
     */

    const selectedProduct =
      String(
        get(
          "productName"
        ) || ""
      ).trim();


    if (selectedProduct) {

      const product =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.PRODUCT_CATALOG
              )
          },

          $or: [
            {
              productCode:
                selectedProduct
            },
            {
              productName:
                selectedProduct
            }
          ]

        });


      if (product) {

        if (
          product.productCode
        ) {

          updates.productCode =
            product.productCode;

        }


        if (
          product.brandName !== undefined &&
          product.brandName !== null
        ) {

          updates.brand =
            product.brandName;

        }


        if (
          product.modelName !== undefined &&
          product.modelName !== null
        ) {

          updates.model =
            product.modelName;

        }


        if (
          product.capacityUnit !== undefined &&
          product.capacityUnit !== null
        ) {

          updates.unit =
            product.capacityUnit;

        }


        if (
          product.supplierCode
        ) {

          updates.supplierCode =
            product.supplierCode;

        }

      }

    }


    /*
     * CUSTOMER
     */

    const selectedCustomer =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (selectedCustomer) {

      const customer =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.CUSTOMERS
              )
          },

          $or: [
            {
              customerCode:
                selectedCustomer
            },
            {
              customerName:
                selectedCustomer
            }
          ]

        });


      if (
        customer &&
        customer.customerCode
      ) {

        updates.customerCode =
          customer.customerCode;

      }

    }


    /*
     * LOCATION
     */

    const selectedLocation =
      String(
        get(
          "locationName"
        ) || ""
      ).trim();


    if (selectedLocation) {

      const location =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.LOCATIONS
              )
          },

          $or: [
            {
              locationCode:
                selectedLocation
            },
            {
              locationName:
                selectedLocation
            }
          ]

        });


      if (location) {

        if (
          location.locationCode
        ) {

          updates.locationCode =
            location.locationCode;

        }


        if (
          location.route !== undefined &&
          location.route !== null
        ) {

          updates.route =
            location.route;

        }

      }

    }


    /*
     * SUPPLIER
     */

    const selectedSupplier =
      String(
        get(
          "supplierName"
        ) || ""
      ).trim();


    if (selectedSupplier) {

      const supplier =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.SUPPLIERS
              )
          },

          $or: [
            {
              supplierCode:
                selectedSupplier
            },
            {
              supplierName:
                selectedSupplier
            }
          ]

        });


      if (
        supplier &&
        supplier.supplierCode
      ) {

        updates.supplierCode =
          supplier.supplierCode;

      }

    }


    if (
      Object.keys(
        updates
      ).length > 0
    ) {

      await updateCurrent(
        updates,
        "MACHINE DERIVED FIELDS"
      );

    }


    return updates;

  }



  /*
   * ============================================================
   * AGREEMENT FIELD RESOLUTION
   * ============================================================
   */

  async function resolveAgreementFields() {

    await refreshDoc();


    const updates = {};


    /*
     * CUSTOMER
     */

    const selectedCustomer =
      String(
        get(
          "customerName"
        ) || ""
      ).trim();


    if (selectedCustomer) {

      const customer =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.CUSTOMERS
              )
          },

          $or: [
            {
              customerCode:
                selectedCustomer
            },
            {
              customerName:
                selectedCustomer
            }
          ]

        });


      if (
        customer &&
        customer.customerCode
      ) {

        updates.customerCode =
          customer.customerCode;

      }

    }


    /*
     * SUPPLIER
     */

    const selectedSupplier =
      String(
        get(
          "supplierName"
        ) || ""
      ).trim();


    if (selectedSupplier) {

      const supplier =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.SUPPLIERS
              )
          },

          $or: [
            {
              supplierCode:
                selectedSupplier
            },
            {
              supplierName:
                selectedSupplier
            }
          ]

        });


      if (
        supplier &&
        supplier.supplierCode
      ) {

        updates.supplierCode =
          supplier.supplierCode;

      }

    }


    /*
     * LOCATION
     */

    const selectedLocation =
      String(
        get(
          "locationName"
        ) || ""
      ).trim();


    if (selectedLocation) {

      const location =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.LOCATIONS
              )
          },

          $or: [
            {
              locationCode:
                selectedLocation
            },
            {
              locationName:
                selectedLocation
            }
          ]

        });


      if (
        location &&
        location.locationCode
      ) {

        updates.locationCode =
          location.locationCode;

      }

    }


    /*
     * PRODUCT
     */

    const selectedProduct =
      String(
        get(
          "productName"
        ) || ""
      ).trim();


    if (selectedProduct) {

      const product =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.PRODUCT_CATALOG
              )
          },

          $or: [
            {
              productCode:
                selectedProduct
            },
            {
              productName:
                selectedProduct
            }
          ]

        });


      if (
        product &&
        product.productCode
      ) {

        updates.productCode =
          product.productCode;

      }


      if (
        product &&
        product.supplierCode &&
        !updates.supplierCode
      ) {

        updates.supplierCode =
          product.supplierCode;

      }

    }


    /*
     * INSTALLED MACHINE
     */

    const selectedMachine =
      String(
        get(
          "serialNumber"
        ) || ""
      ).trim();


    if (selectedMachine) {

      const machine =
        await incidents.findOne({

          workflow: {
            $in:
              workflowValues(
                WF.INSTALLED_MACHINES
              )
          },

          $or: [
            {
              machineId:
                selectedMachine
            },
            {
              serialNumber:
                selectedMachine
            }
          ]

        });


      if (machine) {

        if (
          machine.machineId
        ) {

          updates.machineId =
            machine.machineId;

        }


        /*
         * The machine only fills what the user left empty. A
         * customer / supplier / location / product picked on the
         * agreement wins over the machine's, together with its code.
         */

        [
          ["customerName", "customerCode"],
          ["supplierName", "supplierCode"],
          ["locationName", "locationCode"],
          ["productName", "productCode"]
        ].forEach(
          function (pair) {

            const nameField =
              pair[0];

            const codeField =
              pair[1];


            const picked =
              String(
                get(nameField) || ""
              ).trim() !== "";


            if (picked) {

              return;

            }


            if (
              machine[nameField] !== undefined &&
              machine[nameField] !== null &&
              String(
                machine[nameField]
              ).trim() !== ""
            ) {

              updates[nameField] =
                machine[nameField];

            }


            if (
              machine[codeField] &&
              !updates[codeField]
            ) {

              updates[codeField] =
                machine[codeField];

            }

          }
        );

      }

    }


    if (
      Object.keys(
        updates
      ).length > 0
    ) {

      await updateCurrent(
        updates,
        "AGREEMENT DERIVED FIELDS"
      );

    }


    await refreshDoc();


    console.log(
      "AGREEMENT FINAL:",
      "| customerCode:",
      get("customerCode"),
      "| supplierCode:",
      get("supplierCode"),
      "| locationCode:",
      get("locationCode"),
      "| productCode:",
      get("productCode"),
      "| machineId:",
      get("machineId")
    );

  }


  /*
   * ============================================================
   * AGREEMENT SERVICE SCHEDULE
   *
   * numberOfServices is a 1-4 dropdown. For each selected service
   * the schedule fills Service N Date from First Service Date +
   * (N - 1) x the interval for that count, and defaults Service N Status to
   * Pending. Services above the selected number are cleared.
   *
   * Dates are always recomputed from First Service Date, so the
   * writes are idempotent and the trigger does not loop on its
   * own updates.
   *
   * Keep MAX_SERVICES in sync with Agreement_Warranty_WF.json.
   * ============================================================
   */

  const MAX_SERVICES = 4;

  // Services are spread evenly across a year, so the interval
  // follows from No of Services instead of being entered by hand:
  // 4 services -> every 3 months, 3 -> every 4 months, 2 -> every 6.
  const SERVICE_INTERVAL_MONTHS = {
    1: 12,
    2: 6,
    3: 4,
    4: 3
  };

  // Workflow timeZone is -330 (UTC+5:30). Date arithmetic runs on
  // the local calendar day so month steps land on the right day.
  const LOCAL_OFFSET_MINUTES = 330;


  function parseDateValue(value) {

    if (
      value === undefined ||
      value === null ||
      value === ""
    ) {

      return null;

    }


    if (value instanceof Date) {

      return isNaN(value.getTime())
        ? null
        : {
            ms: value.getTime(),
            kind: "date"
          };

    }


    if (typeof value === "number") {

      return {
        ms: value,
        kind: "number"
      };

    }


    const text =
      String(value).trim();


    if (
      /^\d{4}-\d{2}-\d{2}$/.test(
        text
      )
    ) {

      return {
        ms: Date.parse(
          text + "T00:00:00Z"
        ),
        kind: "dateOnly"
      };

    }


    const ms =
      Date.parse(text);


    return isNaN(ms)
      ? null
      : {
          ms: ms,
          kind: "iso"
        };

  }


  /*
   * Returns the date `steps` intervals after `base`, in the same
   * representation the platform stored base in.
   */

  function addInterval(
    base,
    steps,
    interval,
    unit
  ) {

    const offset =
      base.kind === "dateOnly"
        ? 0
        : LOCAL_OFFSET_MINUTES * 60000;


    const d =
      new Date(
        base.ms + offset
      );


    const amount =
      steps * interval;


    if (
      unit === "Days" ||
      unit === "Weeks"
    ) {

      d.setUTCDate(
        d.getUTCDate() +
          amount *
            (unit === "Weeks" ? 7 : 1)
      );

    } else {

      const months =
        amount *
          (unit === "Years" ? 12 : 1);


      const day =
        d.getUTCDate();


      d.setUTCDate(1);


      d.setUTCMonth(
        d.getUTCMonth() + months
      );


      // Clamp e.g. Jan 31 + 1 month to the last day of February.
      const lastDay =
        new Date(
          Date.UTC(
            d.getUTCFullYear(),
            d.getUTCMonth() + 1,
            0
          )
        ).getUTCDate();


      d.setUTCDate(
        Math.min(day, lastDay)
      );

    }


    const ms =
      d.getTime() - offset;


    if (base.kind === "number") {

      return ms;

    }


    if (base.kind === "dateOnly") {

      return new Date(ms)
        .toISOString()
        .slice(0, 10);

    }


    if (base.kind === "iso") {

      return new Date(ms)
        .toISOString();

    }


    return new Date(ms);

  }


  /*
   * ============================================================
   * AGREEMENT NUMBER
   *
   * Warranty and AMC agreements are numbered separately
   * (W0001, W0002 ... / AMC0001, AMC0002 ...). The number is
   * assigned once, when Agreement Type is first set, and is
   * only changed if an older agreement already holds it.
   *
   * Keep the keys in sync with agreementType in
   * Agreement_Warranty_WF.json.
   * ============================================================
   */

  const AGREEMENT_NUMBER_PREFIXES = {
    Warranty: "W",
    AMC: "AMC"
  };


  async function assignAgreementNumber() {

    await refreshDoc();


    const agreements = {
      $in:
        workflowValues(
          WF.AGREEMENT_WARRANTY
        )
    };


    const current =
      String(
        get("agreementNumber") || ""
      ).trim();


    if (current) {

      // Keep the number unless an older agreement already holds
      // it. The newer duplicate is renumbered below.
      const older =
        await incidents.findOne(
          {
            workflow:
              agreements,

            _id: {
              $lt:
                doc._id
            },

            $or: [
              {
                agreementNumber:
                  current
              },
              {
                name: {
                  $regex:
                    "^#?\\s*" +
                    current +
                    "(\\s|$)"
                }
              }
            ]
          },
          {
            _id: 1
          }
        );


      if (!older) {

        return;

      }


      console.log(
        "DUPLICATE agreementNumber:",
        current,
        "| renumbering"
      );

    }


    const prefix =
      AGREEMENT_NUMBER_PREFIXES[
        String(
          get("agreementType") || ""
        ).trim()
      ];


    if (!prefix) {

      return;

    }


    const pattern =
      new RegExp(
        "^" + prefix + "(\\d+)$"
      );


    // Titles start with the number ("W0001 - Customer"), so they
    // also count when a record's agreementNumber field was lost.
    const titlePattern =
      new RegExp(
        "^#?\\s*" + prefix + "(\\d+)(\\s|$)"
      );


    // Matched here, not in the query: a JS RegExp is not sent to
    // MongoDB as a regex filter from Atlas Functions, so the query
    // found nothing and every agreement became W0001.
    const existing =
      await incidents
        .find(
          {
            workflow:
              agreements,

            _id: {
              $ne:
                doc._id
            }
          },
          {
            agreementNumber: 1,
            name: 1,
            title: 1
          }
        )
        .toArray();


    let max = 0;


    existing.forEach(
      function (record) {

        [
          [record.agreementNumber, pattern],
          [record.name, titlePattern],
          [record.title, titlePattern]
        ].forEach(
          function (pair) {

            const match =
              pair[1].exec(
                String(
                  pair[0] || ""
                ).trim()
              );


            if (match) {

              max =
                Math.max(
                  max,
                  parseInt(match[1], 10)
                );

            }

          }
        );

      }
    );


    const next =
      prefix +
      String(max + 1).padStart(
        4,
        "0"
      );


    await updateCurrent(
      {
        agreementNumber:
          next
      },
      "ASSIGN agreementNumber"
    );

  }


  /*
   * Keep in sync with type.values in Agreement_Warranty_WF.json.
   */

  function serviceRecordType(count) {

    if (count < 1) {

      return "Agreement / Warranty";

    }


    return (
      "Agreement / Warranty - " +
      count +
      (count === 1
        ? " Service"
        : " Services")
    );

  }


  async function resolveServiceSchedule() {

    await refreshDoc();


    const selected =
      parseInt(
        get("numberOfServices"),
        10
      );


    const count =
      isNaN(selected)
        ? 0
        : Math.max(
            0,
            Math.min(
              selected,
              MAX_SERVICES
            )
          );


    const firstDate =
      parseDateValue(
        get("firstServiceDate")
      );


    const interval =
      SERVICE_INTERVAL_MONTHS[count] || 0;


    const unit =
      "Months";


    const canSchedule =
      firstDate &&
      interval > 0;


    const updates = {};


    if (interval > 0) {

      updates.serviceInterval =
        interval;

      updates.serviceIntervalUnit =
        unit;

    }

    const removals = {};

    let completed = 0;


    for (
      let n = 1;
      n <= MAX_SERVICES;
      n++
    ) {

      const dateField =
        "service" + n + "Date";


      const statusField =
        "service" + n + "Status";


      if (n > count) {

        [
          dateField,
          statusField
        ].forEach(
          function (field) {

            if (
              doc[field] !== undefined
            ) {

              removals[field] = "";

            }

          }
        );


        continue;

      }


      if (n === 1 && firstDate) {

        updates[dateField] =
          get("firstServiceDate");

      } else if (canSchedule) {

        updates[dateField] =
          addInterval(
            firstDate,
            n - 1,
            interval,
            unit
          );

      } else if (
        doc[dateField] !== undefined
      ) {

        removals[dateField] = "";

      }


      const status =
        String(
          get(statusField) || ""
        ).trim();


      if (!status) {

        updates[statusField] =
          "Pending";

      }


      if (status === "Completed") {

        completed++;

      }

    }


    if (count > 0) {

      updates.currentCompletedServices =
        completed;

    }


    // Each record type lists only its own service fields in
    // highPriorityFields, so the record shows N services.
    updates.type =
      serviceRecordType(count);


    await updateCurrent(
      updates,
      "AGREEMENT SERVICE SCHEDULE"
    );


    if (
      Object.keys(
        removals
      ).length > 0
    ) {

      await incidents.updateOne(

        {
          _id:
            doc._id
        },

        {
          $unset:
            removals
        }

      );


      Object.keys(
        removals
      ).forEach(
        function (field) {

          delete doc[field];

        }
      );


      console.log(
        "AGREEMENT SERVICES CLEARED:",
        Object.keys(removals).join(", ")
      );

    }


    console.log(
      "AGREEMENT SERVICES:",
      "| selected:",
      count,
      "| completed:",
      completed,
      "| scheduled:",
      canSchedule ? "yes" : "no"
    );

  }


  /*
   * ============================================================
   * REFRESH ONLY WHEN THE DROPDOWN IS AFFECTED
   *
   * Inserts / replaces always refresh. Updates refresh only when
   * one of the dropdown's source fields changed, so editing e.g.
   * a customer's phone number does not rebuild the whole list.
   * ============================================================
   */

  async function refreshSelectorIfChanged(
    selectorField
  ) {

    if (
      operation === "update"
    ) {

      const description =
        changeEvent.updateDescription || {};


      const changed =
        Object.keys(
          description.updatedFields || {}
        ).concat(
          description.removedFields || []
        ).map(
          function (path) {

            return String(
              path
            ).split(".")[0];

          }
        );


      const watched =
        sourceFields(
          selectorField
        );


      const affected =
        changed.some(
          function (field) {

            return watched.indexOf(
              field
            ) !== -1;

          }
        );


      if (!affected) {

        console.log(
          "DROPDOWN SKIPPED:",
          selectorField,
          "| no source field changed"
        );


        return;

      }

    }


    await refreshSelector(
      selectorField
    );

  }


  /*
   * ============================================================
   * ROUTING
   * ============================================================
   */

  try {

    if (
      MASTER_STATUS_WORKFLOWS.indexOf(
        workflowId
      ) !== -1 &&
      MASTER_STATUSES.indexOf(
        get("status")
      ) === -1
    ) {

      await updateCurrent(
        {
          status:
            "Active"
        },
        "MASTER STATUS -> Active"
      );

    }


    switch (
      workflowId
    ) {


      /*
       * CUSTOMER
       */

      case WF.CUSTOMERS: {

        await assignGeneratedCode(
          "customerCode"
        );


        await refreshDoc();


        await refreshSelectorIfChanged(
          "customerName"
        );


        await refreshTitle();


        break;

      }


      /*
       * SUPPLIER
       */

      case WF.SUPPLIERS: {

        await assignGeneratedCode(
          "supplierCode"
        );


        await refreshDoc();


        await refreshSelectorIfChanged(
          "supplierName"
        );


        await refreshTitle();


        break;

      }


      /*
       * LOCATION
       */

      case WF.LOCATIONS: {

        await resolveLocationCustomer();


        await refreshDoc();


        await assignGeneratedCode(
          "locationCode"
        );


        await refreshDoc();


        await refreshSelectorIfChanged(
          "locationName"
        );


        await refreshTitle();


        break;

      }


      /*
       * PRODUCT
       */

      case WF.PRODUCT_CATALOG: {

        await resolveProductSupplier();


        await refreshDoc();


        await assignGeneratedCode(
          "productCode"
        );


        await refreshDoc();


        await refreshSelectorIfChanged(
          "productName"
        );


        await refreshTitle();


        break;

      }


      /*
       * INSTALLED MACHINE
       */

      case WF.INSTALLED_MACHINES: {

        await assignGeneratedCode(
          "machineId"
        );


        await refreshDoc();


        await resolveMachineFields();


        await refreshDoc();


        await refreshSelectorIfChanged(
          "serialNumber"
        );


        await refreshTitle();


        break;

      }


      /*
       * AGREEMENT / WARRANTY
       */

      case WF.AGREEMENT_WARRANTY: {

        console.log(
          "AGREEMENT / WARRANTY PROCESS START"
        );


        await assignAgreementNumber();


        await resolveAgreementFields();


        await resolveServiceSchedule();


        console.log(
          "AGREEMENT / WARRANTY PROCESS END"
        );


        await refreshTitle();


        break;

      }


      default: {

        console.log(
          "Ignored workflow:",
          workflowId
        );


        break;

      }

    }


    console.log(
      "============================================"
    );


    console.log(
      "DIPRA MASTER DATA SYNC COMPLETED"
    );


    console.log(
      "============================================"
    );


    return {

      success:
        true,

      workflow:
        workflowId,

      operation:
        operation

    };


  } catch (error) {

    console.log(
      "============================================"
    );


    console.log(
      "DIPRA MASTER DATA SYNC ERROR"
    );


    console.log(
      "Message:",
      error.message
    );


    if (
      error.stack
    ) {

      console.log(
        error.stack
      );

    }


    console.log(
      "============================================"
    );


    throw error;

  }

};