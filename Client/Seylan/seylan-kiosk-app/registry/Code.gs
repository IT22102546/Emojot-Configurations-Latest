var LOC_HEADERS = ['Location ID', 'Location', 'Sensor URL', 'Max tablets', 'Active', 'PIN'];
var PIN_COL = 6;
var CLAIM_HEADERS = ['Build ID', 'Location ID', 'Location', 'Device ID', 'Device name', 'Claimed at', 'PIN used', 'Released'];
var RELEASED_COL = 8;
var BUILD_HEADERS = ['Build ID', 'Active', 'First seen'];
var LOCKOUT_HEADERS = ['Tablet ID', 'PIN type', 'Branch tried', 'Wrong attempts', 'Locked until', 'Last attempt'];

/* ============================== HTTP ============================== */

function doGet(e) {
  try {
    var p = (e && e.parameter) || {};
    var build = clean_(p.build, 60);
    if (!build) return json_({ ok: false, error: 'missing_build' });
    var buildActive = buildActive_(build);

    if (p.action === 'status') {
      var device = clean_(p.device, 120);
      if (!device) return json_({ ok: false, error: 'missing_device' });
      var claim = deviceClaim_(build, device);
      return json_({ ok: true, claim: claim, buildDisabled: !buildActive });
    }

    if (!buildActive) return json_({ ok: false, error: 'build_disabled' });

    // default: locations
    return json_({ ok: true, locations: locationsFor_(build) });
  } catch (err) {
    console.error(err);
    return json_({ ok: false, error: 'server', message: String(err) });
  }
}

function doPost(e) {
  try {
    var b = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    if (b.action === 'claim') return json_(claim_(b));
    if (b.action === 'unlock') return json_(unlock_(b));
    return json_({ ok: false, error: 'unknown_action' });
  } catch (err) {
    console.error(err);
    return json_({ ok: false, error: 'server', message: String(err) });
  }
}

/* ============================== CLAIM ============================== */

function claim_(b) {
  var build = clean_(b.build, 60);
  var locationId = clean_(b.location, 120);
  var device = clean_(b.device, 120);
  var deviceName = clean_(b.deviceName, 120);
  if (!build || !locationId || !device) return { ok: false, error: 'invalid' };
  if (!buildActive_(build)) return { ok: false, error: 'build_disabled' };

  // Everything runs under the lock, so a one-time PIN can't be used by two tablets at once
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var location = findLocation_(locationId);
    if (!location || !location.active) return { ok: false, error: 'unknown_location' };

    // PIN check (one of this branch's unused one-time PINs) with a per-device lockout
    var lockedOut = lockedOut_(device, 'Setup PIN');
    if (lockedOut) return lockedOut;
    if (!location.pins.length) return { ok: false, error: 'pin_not_configured' };
    var given = String(b.pin || '');
    var pinIndex = given ? location.pins.indexOf(given) : -1;
    if (pinIndex >= 0 && usedPins_().indexOf(given) >= 0) {
      // A PIN that already set up a tablet (e.g. typed back into the sheet) never works again
      location.pins[pinIndex] = freshPin_();
      writePins_(location.row, location.pins);
      pinIndex = -1;
    }
    if (pinIndex < 0) return wrongPin_(device, 'Setup PIN', location.name);
    clearAttempts_(device, 'Setup PIN');

    // A device keeps one location per build. Re-claiming its own location is fine (e.g. after a reinstall).
    var mine = deviceClaim_(build, device);
    if (mine) {
      if (mine.id === location.id) return { ok: true, location: mine, restored: true };
      return { ok: false, error: 'device_already_assigned', location: mine };
    }

    var used = claimsFor_(build).filter(function (c) { return c.locationId === location.id; }).length;
    if (used >= location.max) return { ok: false, error: 'taken' };

    var claims = sheet_('Claims', CLAIM_HEADERS);
    claims.appendRow([build, location.id, location.name, device, deviceName, new Date(), given]);
    claims.getRange(claims.getLastRow(), RELEASED_COL).insertCheckboxes();
    // The PIN is used up: swap it for a fresh one
    location.pins[pinIndex] = freshPin_();
    writePins_(location.row, location.pins);
    return { ok: true, location: { id: location.id, name: location.name, url: location.url } };
  } finally {
    lock.releaseLock();
  }
}

/* ============================== KIOSK EXIT ============================== */

/** Checks the kiosk exit PIN, with the same per-device lockout as setup PINs. */
function unlock_(b) {
  var device = clean_(b.device, 120);
  if (!device) return { ok: false, error: 'invalid' };
  var exitPin = PropertiesService.getScriptProperties().getProperty('EXIT_PIN');
  if (!exitPin) return { ok: false, error: 'pin_not_configured' };
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var lockedOut = lockedOut_(device, 'Exit PIN');
    if (lockedOut) return lockedOut;
    if (String(b.pin || '') !== exitPin) return wrongPin_(device, 'Exit PIN', '');
    clearAttempts_(device, 'Exit PIN');
    return { ok: true };
  } finally {
    lock.releaseLock();
  }
}

/* ============================== LOCKOUTS ============================== */
// Wrong PIN attempts per tablet and PIN type, kept in the Lockouts sheet so a
// row can be deleted to lift a lockout early. Callers hold the script lock.

function attemptRow_(device, type) {
  var rows = sheet_('Lockouts', LOCKOUT_HEADERS).getDataRange().getValues();
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][0]).trim() === device && String(rows[i][1]).trim() === type) {
      return { row: i + 1, count: parseInt(rows[i][3], 10) || 0, until: rows[i][4] instanceof Date ? rows[i][4] : null };
    }
  }
  return null;
}

/** The locked_out response if this tablet is still locked out, otherwise null (an expired lockout is cleared). */
function lockedOut_(device, type) {
  var a = attemptRow_(device, type);
  if (!a || !a.until) return null;
  var left = a.until.getTime() - Date.now();
  if (left <= 0) {
    sheet_('Lockouts', LOCKOUT_HEADERS).deleteRow(a.row);
    return null;
  }
  return { ok: false, error: 'locked_out', minutes: Math.ceil(left / 60000) };
}

function wrongPin_(device, type, branch) {
  var sh = sheet_('Lockouts', LOCKOUT_HEADERS);
  var a = attemptRow_(device, type);
  var count = (a ? a.count : 0) + 1;
  var until = count >= CONFIG.MAX_PIN_ATTEMPTS ? new Date(Date.now() + CONFIG.LOCKOUT_MINUTES * 60000) : '';
  var values = [[device, type, branch, count, until, new Date()]];
  if (a) sh.getRange(a.row, 1, 1, LOCKOUT_HEADERS.length).setValues(values);
  else sh.appendRow(values[0]);
  if (until) return { ok: false, error: 'locked_out', minutes: CONFIG.LOCKOUT_MINUTES };
  return { ok: false, error: 'wrong_pin', attemptsLeft: CONFIG.MAX_PIN_ATTEMPTS - count };
}

function clearAttempts_(device, type) {
  var a = attemptRow_(device, type);
  if (a) sheet_('Lockouts', LOCKOUT_HEADERS).deleteRow(a.row);
}

/* ============================== DATA ============================== */

function locationsFor_(build) {
  var claims = claimsFor_(build);
  return readLocations_().filter(function (l) { return l.active; }).map(function (l) {
    var used = claims.filter(function (c) { return c.locationId === l.id; }).length;
    return { id: l.id, name: l.name, max: l.max, used: used, available: Math.max(0, l.max - used) };
  });
}

function deviceClaim_(build, device) {
  var c = claimsFor_(build).filter(function (x) { return x.device === device; })[0];
  if (!c) return null;
  var l = findLocation_(c.locationId);
  return l ? { id: l.id, name: l.name, url: l.url, active: l.active } : null;
}

function readLocations_() {
  var rows = sheet_('Locations', LOC_HEADERS).getDataRange().getValues();
  return rows.map(function (r, i) { r.row = i + 1; return r; }).slice(1).filter(function (r) { return r[0]; }).map(function (r) {
    return {
      row: r.row,
      id: String(r[0]).trim(),
      name: String(r[1]).trim(),
      url: String(r[2]).trim(),
      max: Math.max(1, parseInt(r[3], 10) || 1),
      active: String(r[4]).toLowerCase() !== 'false' && String(r[4]).toLowerCase() !== 'no',
      pins: String(r[PIN_COL - 1] == null ? '' : r[PIN_COL - 1]).split(/[\s,]+/).filter(String)
    };
  });
}

function findLocation_(id) {
  return readLocations_().filter(function (l) { return l.id === id; })[0] || null;
}

/** Active claims for a build. Released rows are kept for the PIN history but no longer hold a branch. */
function claimsFor_(build) {
  var rows = sheet_('Claims', CLAIM_HEADERS).getDataRange().getValues().slice(1);
  return rows.filter(function (r) { return String(r[0]).trim() === build && !isTrue_(r[RELEASED_COL - 1]); }).map(function (r) {
    return { locationId: String(r[1]).trim(), device: String(r[3]).trim() };
  });
}

/**
 * False when the build is unticked in the Builds sheet. A build seen for the
 * first time is added there as active.
 */
function buildActive_(build) {
  var sh = sheet_('Builds', BUILD_HEADERS);
  var row = sh.getDataRange().getValues().slice(1).filter(function (r) { return String(r[0]).trim() === build; })[0];
  if (row) return String(row[1]).toLowerCase() !== 'false' && String(row[1]).toLowerCase() !== 'no';
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var again = sh.getDataRange().getValues().slice(1).some(function (r) { return String(r[0]).trim() === build; });
    if (!again) {
      sh.appendRow([build, true, new Date()]);
      sh.getRange(sh.getLastRow(), 2).insertCheckboxes();
    }
  } finally {
    lock.releaseLock();
  }
  return true;
}

/* ============================== SHEET ============================== */

function spreadsheet_() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('SHEET_ID');
  if (id) return SpreadsheetApp.openById(id);
  var ss = SpreadsheetApp.create(CONFIG.SPREADSHEET_NAME);
  props.setProperty('SHEET_ID', ss.getId());
  return ss;
}

function sheet_(name, headers) {
  var ss = spreadsheet_();
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(headers);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  }
  return sh;
}

/* ============================== HELPERS ============================== */

function locationId_(url) {
  return String(url).replace(/\/+$/, '').split('/').pop();
}
function newPin_(taken) {
  var min = Math.pow(10, CONFIG.PIN_LENGTH - 1);
  var pin;
  do {
    pin = String(min + Math.floor(Math.random() * 9 * min));
  } while (taken.indexOf(pin) >= 0 || /^(\d)\1+$/.test(pin));
  return pin;
}
function allPins_() {
  return readLocations_().reduce(function (all, l) { return all.concat(l.pins); }, []);
}
/** Every PIN that has already set up a tablet ("PIN used" column of Claims). */
function usedPins_() {
  var rows = sheet_('Claims', CLAIM_HEADERS).getDataRange().getValues().slice(1);
  return rows.map(function (r) { return String(r[6] == null ? '' : r[6]).trim(); }).filter(String);
}
/** A PIN that is not in the sheet now and has never been used. */
function freshPin_() {
  return newPin_(allPins_().concat(usedPins_()));
}
/** PINs are stored as plain text, comma separated, one per tablet the branch allows. */
function writePins_(row, pins) {
  sheet_('Locations', LOC_HEADERS).getRange(row, PIN_COL).setNumberFormat('@').setValue(pins.join(', '));
}
function usedBuilds_() {
  var rows = sheet_('Claims', CLAIM_HEADERS).getDataRange().getValues().slice(1);
  return rows.map(function (r) { return String(r[0]).trim(); }).filter(function (b, i, all) { return b && all.indexOf(b) === i; });
}
function isTrue_(v) { return v === true || /^(true|yes|y|x)$/i.test(String(v).trim()); }
function clean_(v, max) { return String(v == null ? '' : v).trim().slice(0, max || 200); }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

/* ============================== ADMIN ============================== */

/**
 * Run once from the editor (▶ Run → setupRegistry). Creates the "Seylan Kiosk
 * Registry" spreadsheet with the Locations and Claims sheets, and gives every
 * branch one unique one-time PIN per tablet it allows. Safe to run again:
 * existing locations and PINs are kept, missing ones are added. To change a
 * branch's PINs, type new ones in its PIN cell, or clear it and run this again.
 */
function setupRegistry() {
  var sh = sheet_('Locations', LOC_HEADERS);
  // Sheets made before branch PINs existed have no PIN column yet
  sh.getRange(1, PIN_COL).setValue('PIN').setFontWeight('bold');
  var existing = readLocations_().map(function (l) { return l.id; });
  var added = 0;
  LOCATIONS.forEach(function (row) {
    var id = locationId_(row[1]);
    if (existing.indexOf(id) >= 0) return;
    sh.appendRow([id, row[0], row[1], row[2], true, '']);
    added++;
  });

  // Active is a checkbox: untick it to stop the service at that branch
  if (sh.getLastRow() > 1) sh.getRange(2, 5, sh.getLastRow() - 1, 1).insertCheckboxes();

  // Claims sheets made before one-time PINs / resets lack the "PIN used" and "Released" columns
  var claims = sheet_('Claims', CLAIM_HEADERS);
  claims.getRange(1, 1, 1, CLAIM_HEADERS.length).setValues([CLAIM_HEADERS]).setFontWeight('bold');
  if (claims.getLastRow() > 1) claims.getRange(2, RELEASED_COL, claims.getLastRow() - 1, 1).insertCheckboxes();

  sheet_('Lockouts', LOCKOUT_HEADERS);

  // Builds: one row per APK build ID, Active as a checkbox. Builds already in Claims are listed too.
  var seen = usedBuilds_();
  seen.forEach(function (b) { buildActive_(b); });
  var builds = sheet_('Builds', BUILD_HEADERS);
  if (builds.getLastRow() > 1) builds.getRange(2, 2, builds.getLastRow() - 1, 1).insertCheckboxes();

  // Every branch gets one PIN per tablet it allows. A PIN that is used before,
  // or appears twice in the sheet, is replaced, so each PIN can set up one tablet only.
  var locations = readLocations_();
  var taken = usedPins_();
  var newPins = 0;
  var replaced = 0;
  locations.forEach(function (l) {
    var pins = [];
    l.pins.forEach(function (pin) {
      if (taken.indexOf(pin) >= 0) { replaced++; return; }
      taken.push(pin);
      pins.push(pin);
    });
    while (pins.length < l.max) {
      var pin = newPin_(taken);
      taken.push(pin);
      pins.push(pin);
      newPins++;
    }
    if (pins.join(', ') !== l.pins.join(', ')) writePins_(l.row, pins);
  });
  var ss = spreadsheet_();
  // Remove the default empty "Sheet1" if it is still there
  var blank = ss.getSheetByName('Sheet1');
  if (blank && ss.getSheets().length > 1) ss.deleteSheet(blank);

  console.log('Registry: ' + ss.getUrl());
  console.log('Locations added: ' + added + ' (total ' + locations.length + ')');
  console.log('New one-time PINs: ' + newPins + ', of which ' + replaced + ' replaced a used or duplicate PIN (see the PIN column of the Locations sheet)');
  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty('EXIT_PIN')) {
    props.setProperty('EXIT_PIN', newPin_(taken));
    console.log('Kiosk exit PIN created: ' + props.getProperty('EXIT_PIN') + ' (Project Settings → Script properties → EXIT_PIN)');
  } else {
    console.log('Kiosk exit PIN is set (Project Settings → Script properties → EXIT_PIN).');
  }
  if (props.getProperty('ADMIN_PIN')) {
    console.log('ADMIN_PIN is no longer used (one-time PINs only). You can delete it from Project Settings → Script properties.');
  }
}

/** Run from the editor to see how many tablets are set up for each build (released ones not counted). */
function claimsReport() {
  var rows = sheet_('Claims', CLAIM_HEADERS).getDataRange().getValues().slice(1);
  var byBuild = {};
  rows.forEach(function (r) {
    if (!isTrue_(r[RELEASED_COL - 1])) byBuild[r[0]] = (byBuild[r[0]] || 0) + 1;
  });
  console.log(JSON.stringify(byBuild, null, 2));
}
