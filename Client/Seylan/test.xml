<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<cepRules>
    <cepRule id="1" timeWindow="5">
        <params>
            <param>
                <derivedValue>percepticDrillDown</derivedValue>
                <operator>eq</operator>
                <value>"q8555"</value>
            </param>
            <joinOperator>and</joinOperator>
            <joinParam>
                <derivedValue>emoteNumericValue</derivedValue>
                <operator>ld</operator>
                <value>1</value>
            </joinParam>
        </params>
        <engagementActions>
            <action>
                <type>email</type>
                <data>
                    <to>$$emoter$$</to>
                    <subject>Thank you for your feedback!</subject>
                    <bodyType>html</bodyType>
                    <body><![CDATA[
<!--
    Header - This the place which we add banner image. User can change banner image by changing src value in img tag inside the header section.

    Content - This the place which we add content of the email.

    Sensor Load Button  -  In here we can add sensor link to the href attribute. If you no need button you can remove this.

    Footer - This the place we add footer element like company logo and 'power by emojot' text
-->

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet" type="text/css">
    <style type="text/css">
        * {
            margin: 0;
            padding: 0;
            font-size: 100%;
            line-height: 1.65;
        }

        img {
            max-width: 100%;
            margin: 0 auto;
            display: block;
        }

        body,
        .body-wrap {
            width: 100% !important;
            height: 100%;
            background: #E5E4E2;
            background-repeat: no-repeat;
            background-size: cover;
            color: black;
        }


        a:hover {
            text-decoration: underline;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .text-left {
            text-align: left;
        }

        .button {
            display: inline-block;
            color: white;
            background: #ff4712;
            border: solid#ff4712;
            border-width: 10px 20px 8px;
            font-weight: bold;
            border-radius: 4px;
        }

        .button:hover {
            text-decoration: none;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            margin-bottom: 20px;
            line-height: 1.25;
        }

        h1 {
            font-size: 32px;
        }

        h2 {
            font-size: 28px;
        }

        h3 {
            font-size: 24px;
        }

        h4 {
            font-size: 20px;
        }

        h5 {
            font-size: 16px;
        }

        p,
        ul,
        ol {
            font-size: 16px;
            font-weight: normal;
            margin-bottom: 20px;
        }

        .container {
            display: block !important;
            clear: both !important;
            margin: 0 auto !important;
            max-width: 580px !important;
           background:white;
        }

        .container table {
            width: 100% !important;
            border-collapse: collapse;
        }


        .container .masthead h1 {
            margin: 0 auto !important;
            max-width: 90%;
            text-transform: uppercase;
        }

        .container .content {
            background: white;
            padding: 30px 35px;
        }

        .container .content.footer {
            background: white;
            height: 42px;
            padding-top: 2px;
            padding-bottom: 5px;
        }

        .container .content.footer p {
            margin-bottom: 0;
            color: #888;
            text-align: center;
            font-size: 14px;
        }

        .container .content.footer a {
            color: #888;
            text-decoration: none;
            font-weight: bold;
        }

        .container .content.footer a:hover {
            text-decoration: underline;
        }

        @media only screen and (max-width: 699px) {
            h1 {
                font-size: 36px;
            }

            h2 {
                font-size: 32px;
            }

            h3 {
                font-size: 28px;
            }

            h4 {
                font-size: 24px;
            }

            h5 {
                font-size: 20px;
            }

            p,
            ul,
            ol {
                font-size: 17px;
            }
        }
    </style>
</head>

<body>
<table class="body-wrap" style="color: black;">
<tbody>
<tr>
<td><center>
<table class="container" style="border-spacing: 0px;"><!-- Header -->
<tbody>
<tr>
<td align="center" class="masthead"><!-- replace src url with image --> <img src="https://storage.emojot.com/pictures/emailImages/6369f14b0312a900571b82f0-skin1.png" caption="false" width="120" /></td>
</tr>
<tr style="background: white;">
<td><hr style="border: 1px solid #ff4712;" /></td>
</tr>
<!-- Content -->
<tr>
<td class="content">
<div>
<div><span style="font-size: 14px;">Dear $$loyalty_Name_value$$,</span><br /> <br /><span style="font-size: 14px;">We value and appreciate your feedback and invite you to share your experience on <a href="https://www.facebook.com/SeylanBank/" target="_blank" rel="noopener">Facebook</a> / <a href="https://twitter.com/SeylanBank" target="_blank" rel="noopener">Twitter</a>.&nbsp;</span><br />
<p><span style="font-size: 14px;">Please visit our <a href="https://www.seylan.lk/" target="_blank" rel="noopener">website</a> for deals, offers, and news on our products and services!</span></p>
<p><span style="font-size: 14px;">Kind regards,</span><br /><span style="font-size: 14px;"> Seylan CXM Team</span></p>
</div>
<footer>
<div class="powered_by">
<p></p>
</div>
</footer></div>
<footer>
<div class="powered_by">
<p></p>
</div>
</footer></td>
</tr>
<tr style="background: white;">
<td></td>
</tr>
<!-- Footer -->
<tr>
<td class="content footer" height="42">
<table>
<tbody>
<tr>
<td>
<p align="left" style="text-align: left;"><span color="#000000" style="color: #000000;">Powered by Emojot</span></p>
</td>
<td width="200"><a href="http://emojot.com/" style="font-weight: 400;"><span color="#000000" style="color: #000000;"><img style="width: 80px; float: right;" align="right" src="https://storage.emojot.com/logos/emojot/emojot2019.png" width="80" /></span></a></td>
</tr>
</tbody>
</table>
</td>
</tr>
</tbody>
</table>
</center></td>
</tr>
</tbody>
</table>
</body>

</html>

]]>
                    </body>
                    <timeZone>+330</timeZone>
                    <fromEmail>seylancxm@emojot.com</fromEmail>
                    <fromName>Seylan CXM Team</fromName>
                </data>
                <validityPeriod>5</validityPeriod>
            </action>
        </engagementActions>
    </cepRule>
    <cepRule id="2" timeWindow="5">
        <params>
            <param>
                <derivedValue>percepticDrillDown</derivedValue>
                <operator>eq</operator>
                <value>"q8555"</value>
            </param>
            <joinOperator>and</joinOperator>
            <joinParam>
                <derivedValue>emoteNumericValue</derivedValue>
                <operator>gd</operator>
                <value>0</value>
            </joinParam>
        </params>
        <engagementActions>
            <action>
                <type>incident</type>
                <data>
                    <workflowID>63747cf8d899180010c253ee</workflowID>
                    <name>Negative feedback received from :
                        $$loyalty_Name_value$$/$$loyalty_Email_value$$/$$loyalty_Telephone_value$$
                    </name>
                    <assignee>seylancx@emojot.com</assignee>
                    <type>$$emoSignature_Location_value$$</type>
                    <priority>Medium</priority>
                    <status>Open</status>
                    <description>
                        Customer details:
                        Name: $$loyalty_Name_value$$
                        Email: $$loyalty_Email_value$$
                        Telephone: $$loyalty_Telephone_value$$
                        Region: $$emoSignature_Region_value$$
                        Branch: $$emoSignature_Branch_value$$
                        Location: $$emoSignature_Location_value$$
                        Customer response:$$q8555_emote$$
                        Customer comment:
                        $$gp8414_c1_comment_value$$
                    </description>
                    <customFields>

                        <field>
                            <key>response</key>
                            <value>$$q8555_emote$$</value>
                        </field>
                        <field>
                            <key>comment</key>
                            <value>$$gp8414_c1_comment_value$$</value>
                        </field>
                        <field>
                            <key>branch</key>
                            <value>$$emoSignature_Branch_value$$</value>
                        </field>
                        <field>
                            <key>region</key>
                            <value>$$emoSignature_Region_value$$</value>
                        </field>
                        <field>
                            <key>location</key>
                            <value>$$emoSignature_Location_value$$</value>
                        </field>
                        <field>
                            <key>overdue</key>
                            <value>No</value>
                        </field>
                        <field>
                            <key>profileDetailsConsentGiven</key>
                            <value>$$q7389_emote$$</value>
                        </field>
                        <field>
                            <key>uploadedDocuments</key>
                            <value>$$mediafile_p8414$$</value>
                        </field>
                    </customFields>
                </data>
                <validityPeriod>5</validityPeriod>
            </action>
        </engagementActions>
    </cepRule>
	<cepRule id="3" timeWindow="5">
        <params>
            <param>
                <derivedValue>percepticDrillDown</derivedValue>
                <operator>eq</operator>
                <value>"q3029"</value>
            </param>
        </params>

        <engagementActions>
            <action>
                <type>incident</type>
                <data>
                    <workflowID>66b4967ab13ef3e507e2ad5c</workflowID>
                    <name>New Lead Recived From :
                        $$loyalty_Name_value$$/$$loyalty_Email_value$$/$$loyalty_Telephone_value$$
                    </name>
                    <assignee>seylancx@emojot.com</assignee>
                    <type>$$emoSignature_Location_value$$</type>
                    <priority>Medium</priority>
                    <status>Open</status>
                    <description>
                        Customer details:
                        Name: $$loyalty_Name_value$$
                        Email: $$loyalty_Email_value$$
                        Telephone: $$loyalty_Telephone_value$$
                        Region: $$emoSignature_Region_value$$
                        Branch: $$emoSignature_Branch_value$$
                        Location: $$emoSignature_Location_value$$
                        Inquired product:$$q3029_emote$$
                        Other inquiries:$$gp1490_c1_comment_value$$
                    </description>
                    <customFields>

                        <field>
                            <key>response</key>
                            <value>$$q3029_emote$$</value>
                        </field>
                        <field>
                            <key>comment</key>
                            <value>$$gp1490_c1_comment_value$$</value>
                        </field>
                        <field>
                            <key>branch</key>
                            <value>$$emoSignature_Branch_value$$</value>
                        </field>
                        <field>
                            <key>region</key>
                            <value>$$emoSignature_Region_value$$</value>
                        </field>
                        <field>
                            <key>location</key>
                            <value>$$emoSignature_Location_value$$</value>
                        </field>
                        <field>
                            <key>overdue</key>
                            <value>No</value>
                        </field>
                        <field>
                            <key>profileDetailsConsentGiven</key>
                            <value>$$q7389_emote$$</value>
                        </field>
                        <field>
                            <key>uploadedDocuments</key>
                            <value>$$mediafile_p8414$$</value>
                        </field>
                    </customFields>
                </data>
                <validityPeriod>5</validityPeriod>
            </action>
        </engagementActions>
    </cepRule>
</cepRules>