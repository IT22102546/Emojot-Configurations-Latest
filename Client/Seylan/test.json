{
  "reportNamePrefix": "Negative feedback tracking",
  "name": "Seylan CSAT",
  "descriptionFormat": "text",
  "timeZone": -330,
  "timeSpent": {
    "type": "time_accumulation"
  },
  "status": {
    "name": "Status",
    "type": "enum",
    "values": [
      {
        "id": "Open",
        "name": "Open"
      },
      {
        "id": "Review",
        "name": "Review"
      },
      {
        "id": "Inquiry Sent to Branch",
        "name": "Inquiry Sent to Branch",
        "triggers": [
          {
            "template": "liveWF_negativeFeedback_BranchQuery",
            "channel": "email",
            "target": "admin",
            "appendEditUrl": false,
            "contactFilters": [
              "branchContact",
              "overlookContact"
            ],
            "adminUserQuery": {
              "condition": "and",
              "rules": [
                {
                  "field": "region",
                  "operator": "eq",
                  "value": "$region$"
                },
                {
                  "field": "branch",
                  "operator": "eq",
                  "value": "$branch$"
                },
                {
                  "field": "location",
                  "operator": "eq",
                  "value": "$location$"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "Closed",
        "name": "Closed",
        "triggers": [
          {
            "template": "liveWF_issueClosed",
            "channel": "email",
            "target": "admin",
            "appendEditUrl": false,
            "contactFilters": [
              "branchContact",
              "overlookContact"
            ],
            "adminUserQuery": {
              "condition": "and",
              "rules": [
                {
                  "field": "region",
                  "operator": "eq",
                  "value": "$region$"
                },
                {
                  "field": "branch",
                  "operator": "eq",
                  "value": "$branch$"
                },
                {
                  "field": "location",
                  "operator": "eq",
                  "value": "$location$"
                }
              ]
            }
          },
          {
            "template": "liveWF_ticketResolvedCustomer",
            "channel": "email",
            "target": "customer",
            "appendEditUrl": false
          }
        ]
      }
    ],
    "transitions": [
      {
        "sourceState": "Open",
        "targetStates": [
          "Review"
        ]
      },
      {
        "sourceState": "Review",
        "targetStates": [
          "Closed",
          "Inquiry Sent to Branch"
        ]
      },
      {
        "sourceState": "Inquiry Sent to Branch",
        "targetStates": [
          "Closed",
          "Review"
        ]
      },
      {
        "sourceState": "Closed",
        "targetStates": [
          "Open"
        ]
      }
    ]
  },
