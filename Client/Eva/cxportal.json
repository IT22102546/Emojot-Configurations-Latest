        {
          "key": "trimOut",
          "value": true
        }
      ],
      "styles": [
        {
          "id": ".container",
          "key": "width",
          "value": "100%"
        }
      ]
    },
    {
      "title": "Raw Responses",
      "titleStyle": "color:white;background:#008fed;",
