  "workflowCreation": {
    "email": "bot@emojot.com",
    "triggers": [
      {
        "channel": "email",
        "template": "complaintCreationAlert",
        "target": "admin",
        "condition": {
          "or": [
            {
              "==": [
                {
                  "var": "type"
                },
                "Rooms"
              ]
            },
            {
              "==": [
                {
                  "var": "type"
                },
                "Bistro"
              ]
            }
          ]
        },
        "contactFilters": [
          "ticketAssignee",
          "1stlevel"
        ],
        "adminUserQuery": {
          "condition": "and",
          "rules": [
            {
              "field": "Location",
              "operator": "eq",
              "value": "$Location$"
            },
            {
              "field": "Touchpoint",
              "operator": "eq",
              "value": "$Touchpoint$"
            }
          ]
        }
      },
      {
        "channel": "email",
        "template": "ormticketCreationAlert",
        "target": "admin",
        "condition": {
          "or": [
            {
              "==": [
                {
                  "var": "type"
                },
                "googleMap"
              ]
            },
            {
              "==": [
                {
                  "var": "type"
                },
                "booking"
              ]
            }
          ]
        },
        "contactFilters": [
          "ticketAssignee",
          "1stlevel"
        ],
        "adminUserQuery": {
          "condition": "and",
          "rules": [
            {
              "field": "Location",
              "operator": "eq",
              "value": "$Location$"
            }
          ]
        }
      },
      {
        "channel": "sms",
        "template": "Negative Alert SMS V1",
        "target": "admin",
        "contactFilters": [
          "ticketAssignee",
          "1stlevel"
        ],
        "appendEditUrl": true,
        "adminUserQuery": {
          "condition": "and",
          "rules": [
            {
              "field": "Location",
              "operator": "eq",
              "value": "$Location$"
            },
            {
              "field": "Touchpoint",
              "operator": "eq",
              "value": "$Touchpoint$"
            }
          ]
        }
      },
      {
        "channel": "fieldChange",
        "changingFields": [
          {
            "id": "assignee",
            "contactFilters": [
              "ticketAssignee"
            ],
            "adminUserQuery": {
              "condition": "and",
              "rules": [
                {
                  "field": "Location",
                  "operator": "eq",
                  "value": "$Location$"
                },
                {
                  "field": "Touchpoint",
                  "operator": "eq",
                  "value": "$Touchpoint$"
                }
              ]
            }
          }
        ]
      }
    ]
