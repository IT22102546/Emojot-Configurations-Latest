  "assignment": {
    "automaticAssignment": {
      "isEnabled": true,
      "email": "bot@gmail.com",
      "resolvedStatus": [
        "Resolved"
      ],
      "filteringQuery": {
        "condition": "and",
        "rules": [
          {
            "field": "overdue",
            "operator": "ne",
            "value": "3rd Level"
          }
        ]
      },
      "triggerFlows": [
        {
          "condition": {
            "==": [
              {
                "var": "status"
              },
              "Open"
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 600000
            },
            {
              "nextLevelTime": 1200000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        },
        {
          "condition": {
            "and": [
              {
                "==": [
                  {
                    "var": "status"
                  },
                  "In Progress"
                ]
              },
              {
                "!=": [
                  {
                    "var": "overdue"
                  },
                  "2nd Level"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 1200000
            },
            {
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        },
        {
          "condition": {
            "and": [
              {
                "==": [
                  {
                    "var": "status"
                  },
                  "In Progress"
                ]
              },
              {
                "==": [
                  {
                    "var": "overdue"
                  },
                  "2nd Level"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 1200000
            },
            {
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        }
      ]
    }
  },
