{
  "name": "complaintWorkflow",
  "reportNamePrefix": "Alliancd Finalance Complaint",
  "nameTemplate": "Alliancd Finalance Complaint: $type$ - $complaintType$",
  "reporterNamePrefix": "Complaint",
  "descriptionFormat": "text",
  "timeZone": "+330",
  "type": {
