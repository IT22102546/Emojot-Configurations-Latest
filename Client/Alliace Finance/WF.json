  "workflowCreation": {
    "email": "bot@emojot.com",
    "triggers": [
      {
        "channel": "email",
        "template": "piiRequestCreationAlert",
        "target": "admin",
        "contacts": [
          "sanjanan@emojot.com"
        ],
        "condition": {
          "in": [
            {
              "var": "type"
            },
            [
              "Vehicle / Equipment Leasing",
              "Fixed Deposit (FD)",
              "Hapannu Minor Savings (Children’s Savings)",
              "Solar Loan",
              "Gold Loan",
              "Regular - Savings",
              "Ran Ayojana"
            ]
          ]
        }
      },
      {
        "template": "piiRequestCreationAlertCustomer",
        "channel": "email",
        "target": "customer",
        "appendEditUrl": false,
        "condition": {
          "in": [
            {
              "var": "type"
            },
            [
              "Vehicle / Equipment Leasing",
              "Fixed Deposit (FD)",
              "Hapannu Minor Savings (Children’s Savings)",
              "Solar Loan",
              "Gold Loan",
              "Regular - Savings",
              "Ran Ayojana"
            ]
          ]
        }
      },
      {
        "channel": "fieldChange",
        "changingFields": [
          {
            "id": "assignee",
            "value": "sanjanan@emojot.com"
          }
        ]
      }
    ]
  },
  "assignment": {
    "automaticAssignment": {
      "isEnabled": true,
      "email": "sanjanan@emojot.com",
      "resolvedStatus": [
        "Completed",
        "Rejected"
      ],
      "maxLevel": 4,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 3600000
            },
            {
              "nextLevelTime": 3600000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "1st Level"
                }
              ]
            },
            {
              "nextLevelTime": 3600000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "nextLevelTime": 3600000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "adminHierarchy": {
    "id": "REPLACE_PLATFORMSEC_ADMIN_HIERARCHY_ID",
    "list": "admin",
    "headers": [
      {
        "id": "requesterType",
        "name": "Requester Type",
        "type": "customField"
      },
      {
        "id": "requestType",
        "name": "Request Type",
        "type": "customField"
      },
      {
        "id": "ticketAssignee",
        "name": "Ticket Assignee",
        "type": "contact"
      }
    ]
  },
  "finalState": true,
  "incidentKeyFormat": {
    "enabled": false,
    "countDependentFields": {
      "enabled": true,
      "fields": [
        "date",
        "ticketCategory"
      ]
    },
    "pattern": [
      {
        "key": "ticketCategory",
        "format": "mapping"
      },
      {
        "key": "date",
        "format": "YYYYMMDD"
      },
      {
        "key": "counter",
        "format": 3
      }
    ],
    "counterReset": "daily"
  },
 
  "tableEdit": "true"
}