  "workflowCreation": {
    "email": "bot@emojot.com",
    "triggers": [
      {
        "channel": "email",
        "template": "complaintCreationAlert",
        "target": "admin",
        "contacts": [
          "sanjanan@emojot.com"
        ],
        "condition": {
          "in": [
            {
              "var": "type"
            },
            [
              "Vehicle / Equipment Leasing",
              "Fixed Deposit (FD)",
              "Hapannu Minor Savings (Children’s Savings)",
              "Solar Loan",
              "Gold Loan",
              "Regular - Savings",
              "Ran Ayojana"
            ]
          ]
        }
      },
      {
        "template": "customerComplaintCreation",
        "channel": "email",
        "target": "customer",
        "appendEditUrl": false,
        "condition": {
          "in": [
            {
              "var": "type"
            },
            [
              "Vehicle / Equipment Leasing",
              "Fixed Deposit (FD)",
              "Hapannu Minor Savings (Children’s Savings)",
              "Solar Loan",
              "Gold Loan",
              "Regular - Savings",
              "Ran Ayojana"
            ]
          ]
        }
      },
      {
        "channel": "fieldChange",
        "changingFields": [
          {
            "id": "assignee",
            "value": "sanjanan@emojot.com"
          }
        ]
      }
    ]
  },
  "assignment": {
    "triggers": [
      {
        "template": "complaintCreationAlert",
        "channel": "email",
        "target": "employee"
      }
    ],
    "automaticAssignment": {
      "isEnabled": true,
      "email": "sanjanan@emojot.com",
      "resolvedStatus": [
        "Resolved"
      ],
      "maxLevel": 4,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 604800000
            },
            {
              "nextLevelTime": 604800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "1st Level"
                }
              ]
            },
            {
              "nextLevelTime": 604800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "nextLevelTime": 604800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        }
      ]
    }
  },
