{
  "reportNamePrefix": "Complaint",
  "reporterNamePrefix": "Customer",
  "descriptionFormat": "text",
  "type": {
    "name": "Complaint Type",
    "readOnly": false,
    "type": "enum",
    "values": [
      {
        "id": "Customer Feedback Survey",
        "name": "Customer Feedback Survey",
        "fieldsValidation": [
          {
            "fieldID": "validateTypeChange",
            "required": true,
            "message": "Survey type change confirmation required before saving updates."
          }
        ],
        "triggers": [
          {
            "channel": "fieldChange",
            "changingFields": [
              {
                "id": "complaintDepartment",
                "value": "customerFeedbackSurvey"
              }
            ]
          }
        ],
        "highPriorityFields": [
          "branch",
          "customerFeedbackSatisfaction",
          "customerName",
          "customerEmail",
          "customerTelephone",
          "internalDocumentation",
          "overdue",
          "timeSpent",
          "complaintCategory",
          "issueDescription"
        ]
      },
      {
        "id": "Website Survey",
        "name": "Website Survey",
        "fieldsValidation": [
          {
            "fieldID": "validateTypeChange",
            "required": true,
            "message": "Survey type change confirmation required before saving updates."
          }
        ],
        "triggers": [
          {
            "channel": "fieldChange",
            "changingFields": [
              {
                "id": "complaintDepartment",
                "value": "WebsiteSurvey"
              }
            ]
          }
        ],
        "highPriorityFields": [
          "websiteExperienceArea",
          "websiteOverallSatisfaction",
          "bankServiceProblemArea",
          "bankServiceImprovementComment",
          "websiteProblemArea",
          "websiteIssueDescription",
          "supportIssue",
          "supportImprovementComment",
          "npsScore",
          "customerName",
          "customerEmail",
          "customerTelephone",
          "internalDocumentation",
          "overdue",
          "timeSpent"
        ]
      },
      {
        "id": "Call Center Survey",
        "name": "Call Center Survey",
        "fieldsValidation": [
          {
            "fieldID": "validateTypeChange",
            "required": true,
            "message": "Survey type change confirmation required before saving updates."
          }
        ],
        "triggers": [
          {
            "channel": "fieldChange",
            "changingFields": [
              {
                "id": "complaintDepartment",
                "value": "CallcenterSurvey"
              }
            ]
          }
        ],
        "highPriorityFields": [
          "branch",
          "complaintCategory",
          "sourceIssue",
          "issueDescription",
          "callRecording",
          "language",
          "customerDetailsLink",
          "internalDocumentation",
