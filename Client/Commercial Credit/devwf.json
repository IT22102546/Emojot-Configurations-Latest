  "name": "Commercial_Credit_wf",
  "assignment": {
    "automaticAssignment": {
      "isEnabled": true,
      "email": "testcmu@commercialcredit.lk",
      "resolvedStatus": [
        "Resolved"
      ],
      "maxLevel": 4,
      "triggerFlows": [
        {
          "condition": {
            "and": [
              {
                "!=": [
                  {
                    "var": "status"
                  },
                  "Resolved"
                ]
              }
            ]
          },
          "skipAssignment": true,
          "levels": [
            {
              "nextLevelTime": 604800000
            },
            {
              "nextLevelTime": 604800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "1st Level"
                }
              ]
            },
            {
              "nextLevelTime": 604800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "2nd Level"
                }
              ]
            },
            {
              "nextLevelTime": 604800000,
              "fieldsChange": [
                {
                  "id": "overdue",
                  "value": "3rd Level"
                }
              ]
            }
          ]
        }
      ]
    }
  },
